{
  "schema_id": "scene_behavior_graph_scene_08_synchronized_part_to_pallet_loading_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 08：物料与托盘同步到位装载 Golden SceneBehaviorGraph",
  "description": "物料侧出料台和传送带持续送料，托盘侧传送带同步运输空托盘；当物料和托盘都到位时，机械臂把物料装到托盘，达到数量后托盘输出。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/8.png",
    "case": "docs/test/case/scene_08"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "场景包含物料出料台、物料侧传送带、托盘、托盘侧传送带和一台机械臂。物料出料台持续输出工件，工件进入物料传送带并按停留点排队。空托盘进入托盘传送带并移动到装载位置。当物料传送带出口有工件且托盘位到达装载位置时，机械臂抓取工件并放入托盘空槽。装载过程中，后续物料和托盘必须停在各自传送带上游停留点等待。托盘达到目标装载数量后，托盘传送带继续将该托盘运输到出口并离开系统，后续空托盘补位。",
    "assumptions": [
      "单个托盘目标装载数量为 12。",
      "后续空托盘用同一 carrier_tray_1 规范表示。",
      "托盘槽位选择使用 first_empty_slot。"
    ],
    "open_questions": [
      "托盘目标装载数量是否固定为 12？",
      "物料是否需要按类别放入指定槽位？"
    ]
  },
  "modules": [
    {
      "module_id": "part_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "part_source_1",
        "part_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "part_conveyor.part_ready"
    },
    {
      "module_id": "pallet_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "pallet_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "pallet.ready_for_loading"
    },
    {
      "module_id": "synchronized_robot_loading",
      "mode": "cyclic",
      "devices": [
        "robot_1",
        "pallet_1"
      ],
      "start_event": "loading.inputs_ready",
      "stop_condition": "current pallet load_count reaches target"
    },
    {
      "module_id": "loaded_pallet_release",
      "mode": "one_shot_per_pallet",
      "devices": [
        "pallet_conveyor_1"
      ],
      "start_event": "pallet.load_complete",
      "stop_condition": "loaded pallet exits"
    }
  ],
