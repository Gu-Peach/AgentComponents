    {
      "module_id": "retrieve_with_lift",
      "mode": "cyclic",
      "devices": [
        "storage_rack_1",
        "outbound_lift_1"
      ],
      "start_event": "storage.request_release",
      "stop_condition": "requested outbound count released"
    },
    {
