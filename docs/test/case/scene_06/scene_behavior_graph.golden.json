{
  "schema_id": "scene_behavior_graph_scene_06_storage_rack_dual_lift_buffering_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 06：仓储柜双升降台入库出库 Golden SceneBehaviorGraph",
  "description": "出料口间隔出物料，经入口传送带到第一升降台，升降台把物料放入空闲库位；第二升降台从库位取料并送到末端传送带输出。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/6.png",
    "case": "docs/test/case/scene_06"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "左侧出料口按节拍生成物料，物料进入入口传送带并按停留点前进到第一升降台。第一升降台空闲且仓储柜存在空库位时，接收物料、移动到对应高度并将物料存入库位。第一升降台工作时，入口传送带出口物料等待，后续物料依次停在上游停留点。第二升降台根据出库策略从仓储柜取出物料，移动到末端传送带对接高度并释放物料。末端传送带按停留点运输到出口后物料离开系统。",
    "assumptions": [
      "存储柜 baseline 使用 first_available 库位策略。",
      "出库策略为 FIFO 或按最早入库顺序。",
      "升降台高度与库位层级映射由 Runtime 根据 storage cell 解析。"
    ],
    "open_questions": [
      "入库和出库是否同时进行？",
      "是否需要指定目标库位而不是 first_available？"
    ]
  },
  "modules": [
    {
      "module_id": "inbound_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "source_station_1",
        "inbound_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "inbound_conveyor.part_ready"
    },
    {
