      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "outbound_conveyor_1"
      ],
      "start_event": "outbound_lift.material_released",
      "stop_condition": "outbound conveyor empty"
    }
  ],
