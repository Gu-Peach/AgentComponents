{
  "schema_id": "scene_behavior_graph_scene_03_two_robot_handoff_transport_line_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 03：双机械臂接力运输机构 Golden SceneBehaviorGraph",
  "description": "右侧上料台产生物料，物料经右侧传送带到达终点后由第一台机械臂搬到固定交接位，第二台机械臂再从交接位搬到左侧传送带输出。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/3.png",
    "case": "docs/test/case/scene_03"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "右侧物料上料台持续或按需生成工件，工件进入右侧传送带并按停留点移动到出口。当出口停留点有工件且第一台机械臂空闲时，robot_1 抓取工件并放到中间固定交接位。交接位被占用后，robot_2 在空闲且左侧传送带入口可接收时接走工件，并放入左侧传送带。左侧传送带继续按停留点运输到出口并释放。传送带默认只启用排队等待，也允许通过 capacity_threshold 扩展超载控制。",
    "assumptions": [
      "固定交接位作为 SceneBehaviorGraph 状态资源建模，不新增独立 DeviceSpec。",
      "当前 baseline 启用排队等待；若用户要求超载，则使用同一 capacity_threshold 策略。"
    ],
    "open_questions": [
      "固定交接位是否需要独立 3D 资产和 DeviceSpec？",
      "物料生成是固定数量还是持续生成？"
    ]
  },
  "modules": [
    {
      "module_id": "source_to_input_conveyor",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "source_station_1",
        "right_in_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "input_conveyor.part_ready"
    },
    {
      "module_id": "robot_1_to_handoff",
      "mode": "cyclic",
      "devices": [
        "robot_1"
      ],
      "start_event": "input_conveyor.part_ready",
      "stop_condition": "source batch empty and handoff drained"
    },
    {
      "module_id": "robot_2_to_output_conveyor",
      "mode": "cyclic",
      "devices": [
        "robot_2",
        "left_out_conveyor_1"
      ],
      "start_event": "handoff_buffer.occupied",
      "stop_condition": "handoff_buffer empty and output conveyor empty"
    }
  ],
  "event_bus": {
