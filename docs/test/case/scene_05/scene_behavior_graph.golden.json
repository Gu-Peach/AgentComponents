  "behavior_rules": [
    {
      "rule_id": "accept_material_to_first_available_stop_point",
      "module_id": "multi_output_conveying",
      "description": "物料或托盘进入传送带时，先选择入口侧可用停留点；没有可用点则进入等待队列。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.material_arrived"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].current_load < conveyor_loads[trigger.payload.conveyor_id].max_capacity"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_stop_point_selection",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "material_id": "trigger.payload.material_id"
        },
        "bind_outputs_to": {
          "point_id": "action.payload.point_id"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "accept_material",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "point_id": "policy.point_id"
        }
      }
    },
    {
      "rule_id": "advance_material_to_next_stop_point",
      "module_id": "multi_output_conveying",
      "description": "当前方停留点可用时，物料向出口方向推进一个停留点。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "next_stop_point(trigger.payload.conveyor_id, trigger.payload.point_id).occupied == false"
        ],
        "any": [],
        "none": [
          "conveyor_loads[trigger.payload.conveyor_id].blocked == true"
        ]
      },
      "policy": {
        "policy_id": "downstream_release",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "point_id": "trigger.payload.point_id"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "advance_to_next_stop_point",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "from_point_id": "trigger.payload.point_id"
        }
      }
    },
    {
      "rule_id": "wait_when_next_stop_point_occupied",
      "module_id": "multi_output_conveying",
      "description": "当前方停留点或下游不可接收时，物料保持在当前停留点并进入等待队列。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "current_stop_point(trigger.payload.conveyor_id, trigger.payload.point_id).occupied == true"
        ],
        "any": [
          "next_stop_point(trigger.payload.conveyor_id, trigger.payload.point_id).occupied == true",
          "downstream_available(trigger.payload.conveyor_id) == false"
        ],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_queue_wait",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "material_id": "trigger.payload.material_id",
          "point_id": "trigger.payload.point_id"
        }
      },
      "action": {
        "type": "update_state",
        "payload": {
          "append": "conveyor_queues[trigger.payload.conveyor_id].waiting_materials",
          "material_id": "trigger.payload.material_id"
        }
      }
    },
    {
      "rule_id": "release_material_when_downstream_available",
      "module_id": "multi_output_conveying",
      "description": "出口停留点有物料且下游可接收时，从传送带出口释放物料。",
      "trigger": {
        "type": "scheduler_tick",
        "state": "exit_stop_point_occupied and downstream_available"
      },
      "guard": {
        "all": [
          "exit_stop_point(trigger.conveyor_id).occupied == true",
          "downstream_available(trigger.conveyor_id) == true"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "downstream_release",
        "inputs": {
          "conveyor_id": "trigger.conveyor_id"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.conveyor_id",
        "behavior_id": "release_material"
      }
    },
    {
      "rule_id": "emit_blocked_when_no_stop_point_available",
      "module_id": "multi_output_conveying",
      "description": "传送带无可用停留点、容量满或下游不可接收时，发出 blocked 事件。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.material_arrived"
      },
      "guard": {
        "all": [],
        "any": [
          "conveyor_loads[trigger.payload.conveyor_id].current_load >= conveyor_loads[trigger.payload.conveyor_id].max_capacity",
          "no_available_stop_point(trigger.payload.conveyor_id) == true",
          "downstream_available(trigger.payload.conveyor_id) == false"
        ],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.blocked",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "reason": "no_stop_point_or_capacity_full"
        }
      }
    },
    {
      "rule_id": "emit_capacity_available_when_stop_point_released",
      "module_id": "multi_output_conveying",
      "description": "停留点释放且负载低于恢复阈值时，发出 capacity_available 事件。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_released"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].current_load <= conveyor_loads[trigger.payload.conveyor_id].resume_threshold"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.capacity_available",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      }
    },
    {
      "rule_id": "pause_upstream_when_conveyor_blocked",
      "module_id": "backpressure_control",
      "description": "传送带 blocked 后暂停对应上游设备启动新动作。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.blocked"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].blocked == true"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      },
      "action": {
        "type": "emit_event",
        "event_id": "upstream.pause",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "reason": "trigger.payload.reason"
        }
      }
    },
    {
      "rule_id": "resume_upstream_when_capacity_available",
      "module_id": "backpressure_control",
      "description": "传送带恢复容量后恢复上游设备启动新动作。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.capacity_available"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].blocked == false"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      },
      "action": {
        "type": "emit_event",
        "event_id": "upstream.resume",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      }
    },
    {
      "rule_id": "round_table_generates_material",
      "module_id": "round_table_material_supply",
      "description": "人工上料被抽象为圆桌固定工位生成待分拣物料。",
      "trigger": {
        "type": "event",
        "event_id": "runtime.sim_start"
      },
      "guard": {
        "all": [
          "round_table_1.station_a capacity available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "deterministic_priority",
        "inputs": {
          "cycle": "manual_feed_interval"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "round_table_1",
        "behavior_id": "accept_material",
        "payload": {
          "station_id": "station_a",
          "source": "manual_feed_simulated"
        }
      }
    },
    {
      "rule_id": "idle_robot_claims_round_table_part",
      "module_id": "dual_robot_table_dispatch",
      "description": "空闲机械臂从圆桌共享工件池 claim 物料。",
      "trigger": {
        "type": "event",
        "event_id": "round_table.material_available"
      },
      "guard": {
        "all": [
          "any robot idle",
          "round_table_workpiece_pool not empty"
        ],
        "any": [],
        "none": [
          "all output conveyors blocked"
        ]
      },
      "policy": {
        "policy_id": "shared_table_workpiece_claim",
        "inputs": {
          "candidate_robots": [
            "robot_1",
            "robot_2"
          ]
        }
      },
      "action": {
        "type": "emit_event",
        "event_id": "global.workpiece_claimed",
        "payload": {
          "robot_id": "policy.robot_id",
          "material_id": "policy.material_id"
        }
      }
    },
    {
      "rule_id": "robot_places_part_to_available_output",
      "module_id": "dual_robot_table_dispatch",
      "description": "机械臂把 claim 的物料放到负载较低且未 blocked 的出料传送带。",
      "trigger": {
        "type": "event",
        "event_id": "global.workpiece_claimed"
      },
      "guard": {
        "all": [
          "device_states[trigger.payload.robot_id] == idle",
          "exists available output conveyor"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "target_conveyor_selection",
        "inputs": {
          "material_id": "trigger.payload.material_id"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.robot_id",
        "behavior_id": "pick_and_place",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "target_conveyor_id": "policy.target_conveyor_id"
        }
      }
    }
  ],
  "state_transition_rules": [
    {
      "rule_id": "conveyor_material_accept_updates_stop_point",
      "on_behavior_complete": "*.accept_material",
      "effects": [
        "set conveyor_occupancy[conveyor_id][selected_stop_point] = material_id",
        "increment conveyor_loads[conveyor_id].current_load",
        "emit conveyor.stop_point_occupied"
      ]
    },
    {
      "rule_id": "conveyor_stop_point_advance_updates_occupancy",
      "on_behavior_complete": "*.advance_to_next_stop_point",
      "effects": [
        "clear conveyor_occupancy[conveyor_id][from_point_id]",
        "set conveyor_occupancy[conveyor_id][to_point_id] = material_id",
        "emit conveyor.stop_point_released",
        "emit conveyor.stop_point_occupied"
      ]
    },
    {
      "rule_id": "conveyor_release_updates_capacity",
      "on_behavior_complete": "*.release_material",
      "effects": [
        "clear conveyor_occupancy[conveyor_id][exit_stop_point]",
        "decrement conveyor_loads[conveyor_id].current_load",
        "emit conveyor.stop_point_released",
        "if blocked == true and current_load <= resume_threshold emit conveyor.capacity_available"
      ]
    },
    {
      "rule_id": "conveyor_blocked_updates_state",
      "on_event": "conveyor.blocked",
      "effects": [
        "set conveyor_loads[conveyor_id].blocked = true",
        "set device_states[conveyor_id] = blocked"
      ]
    },
    {
      "rule_id": "conveyor_capacity_available_updates_state",
      "on_event": "conveyor.capacity_available",
      "effects": [
        "set conveyor_loads[conveyor_id].blocked = false",
        "set device_states[conveyor_id] = idle if no active action"
      ]
    },
    {
      "rule_id": "process_done_recorded",
      "on_event": "global.process_done",
      "effects": [
        "set process_status.scene_05_round_table_dual_robot_dispatch = done"
      ]
    },
    {
      "rule_id": "idle_robot_claims_round_table_part_emits_global_workpiece_claimed",
      "on_rule_complete": "idle_robot_claims_round_table_part",
      "effects": [
        "emit global.workpiece_claimed"
      ]
    }
  ],
  "policies": {
    "deterministic_priority": {
      "type": "deterministic_priority",
      "description": "按工艺阶段和设备优先级选择下一条可执行规则。"
    },
    "conveyor_queue_wait": {
      "type": "queue_wait",
      "queue_scope": "conveyor_stop_points",
      "wait_when": "next_stop_point_occupied or downstream_unavailable",
      "resume_when": "stop_point_released or downstream_available"
    },
    "conveyor_stop_point_selection": {
      "type": "nearest_available_stop_point",
      "search_direction": "towards_exit",
      "fallback": "wait_at_nearest_upstream_stop_point"
    },
    "backpressure": {
      "type": "capacity_threshold",
      "blocked_when": "current_load >= max_capacity or no_available_stop_point",
      "resume_when": "current_load <= resume_threshold and stop_point_released",
      "pause_strategy": "pause_before_next_action"
    },
    "downstream_release": {
      "type": "downstream_release",
      "release_when": "downstream_entry_available and exit_stop_point_occupied",
      "on_blocked": "queue_wait"
    },
    "resource_lock": {
      "type": "resource_lock",
      "resources": [
        "robot_arm",
        "gripper",
        "belt_surface",
        "lift_platform",
        "rotary_plate",
        "storage_cells"
      ],
      "exclusive": true
    },
    "deadlock_detection": {
      "type": "deadlock_detection",
      "condition": "no_enabled_behavior and completion_conditions_not_met",
      "emit": "observation.deadlock_detected"
    },
    "shared_table_workpiece_claim": {
      "type": "shared_pool_claim",
      "source_pool": "round_table_workpiece_pool",
      "mutual_exclusion": true
    },
    "target_conveyor_selection": {
      "type": "load_balancing",
      "candidates": [
        "out_conveyor_1",
        "out_conveyor_2",
        "out_conveyor_3",
        "out_conveyor_4"
      ],
      "exclude_when": "conveyor_loads[candidate].blocked == true"
    }
  },
  "completion_conditions": [
    "round_table_workpiece_pool empty after requested count",
    "all output conveyor stop points are empty",
    "active_actions.empty == true"
  ],
  "failure_observations": [
    {
      "observation_id": "deadlock_detected",
      "condition": "no_enabled_behavior and completion_conditions_not_met",
      "emit_event": "observation.deadlock_detected"
    },
    {
      "observation_id": "queue_timeout",
      "condition": "item waits in conveyor_queues longer than timeout",
      "emit_event": "observation.deadlock_detected"
    }
  ]
}
