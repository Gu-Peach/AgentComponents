          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
          "path": "event_bus.subscriptions.backpressure"
        }
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
