{
  "schema_id": "scene_behavior_graph_scene_05_round_table_dual_robot_dispatch_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 05：圆桌双机械臂多出料分拣 Golden SceneBehaviorGraph",
  "description": "圆桌固定位置生成物料，两台机械臂从圆桌取料并放到空闲出料传送带，多个出料传送带按停留点容量接收物料。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/5.png",
    "case": "docs/test/case/scene_05"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "圆桌中心作为物料呈现区域，物料由人工上料过程简化为 Runtime 在圆桌固定位置生成。两台机械臂监控圆桌上的待处理物料，谁空闲谁 claim 一个物料，并根据出料传送带容量选择空闲或负载较低的目标传送带。目标传送带入口停留点可用时，机械臂执行 pick_and_place；如果某条传送带 blocked，则该传送带不参与目标选择。所有出料传送带都必须按停留点推进和释放。",
    "assumptions": [
      "工人上料简化为 round_table_1.station_a 的物料生成事件。",
      "圆桌不必持续旋转，作为固定呈现台使用；后续可扩展 rotary indexing。"
    ],
    "open_questions": [
      "不同出料传送带是否代表不同类别？",
      "圆桌是否需要真实旋转节拍？"
    ]
  },
  "modules": [
    {
      "module_id": "round_table_material_supply",
      "mode": "periodic",
      "devices": [
        "round_table_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "round_table.material_available"
    },
    {
      "module_id": "dual_robot_table_dispatch",
      "mode": "parallel_continuous",
      "devices": [
        "robot_1",
        "robot_2"
      ],
      "start_event": "round_table.material_available",
      "stop_condition": "round_table workpiece pool empty"
    },
    {
      "module_id": "multi_output_conveying",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "out_conveyor_1",
        "out_conveyor_2",
        "out_conveyor_3",
        "out_conveyor_4"
      ],
      "start_event": "robot.pick_done",
      "stop_condition": "all output conveyors empty"
    }
  ],
  "event_bus": {
    "events": [
      {
