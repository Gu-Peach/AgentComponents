{
  "schema_id": "scene_behavior_graph_scene_04_inline_conveyor_robot_processing_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 04：传送带中段机械臂加工模拟 Golden SceneBehaviorGraph",
  "description": "传送带起点直接生成或接收物料，物料移动到中间加工停留点后由机械臂执行固定位置操作，完成后继续沿传送带输出。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/4.png",
    "case": "docs/test/case/scene_04"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "物料由传送带起点的上料台生成并进入主传送带，主传送带按停留点推进。工件到达中间加工停留点后，传送带暂停该工件的继续前进，空闲机械臂移动到固定加工位置执行一次模拟加工动作。加工完成后释放该停留点，物料继续沿传送带向出口移动并离开系统。若中间加工点被占用，后续物料停在上游停留点等待。",
    "assumptions": [
      "机械臂加工动作暂用 pick_and_place 到同一工位的方式表达，后续可扩展 process_at_station 行为。",
      "robot_2 作为备用设备，baseline 优先 robot_1。"
    ],
    "open_questions": [
      "是否需要两个机械臂同时加工不同停留点？",
      "加工时长是否固定？"
    ]
  },
  "modules": [
    {
      "module_id": "material_generation",
      "mode": "periodic",
      "devices": [
        "source_station_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "source.material_available"
    },
    {
      "module_id": "inline_stop_point_transport",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "main_conveyor_1"
      ],
      "start_event": "source.material_available",
      "stop_condition": "requested parts processed and conveyor empty"
    },
    {
      "module_id": "robot_processing_at_midpoint",
      "mode": "cyclic",
      "devices": [
        "robot_1",
        "robot_2"
      ],
      "start_event": "workpiece.processing_position_ready",
      "stop_condition": "all parts processed"
    }
  ],
  "event_bus": {
    "events": [
      {
        "event_id": "runtime.sim_start",
        "kind": "global_event",
        "payload_schema": {},
        "retention": "event_log",
        "source": "runtime"
      },
      {
        "event_id": "conveyor.material_arrived",
        "kind": "device_signal",
        "payload_schema": {
          "conveyor_id": "string",
          "material_id": "string",
          "from": "string"
        },
        "retention": "event_log",
        "source": "conveyor"
      },
      {
        "event_id": "conveyor.stop_point_occupied",
        "kind": "device_signal",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log",
        "source": "conveyor"
      },
      {
        "event_id": "conveyor.stop_point_released",
        "kind": "device_signal",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log",
        "source": "conveyor"
      },
      {
        "event_id": "conveyor.blocked",
        "kind": "device_signal",
        "payload_schema": {
          "conveyor_id": "string",
          "current_load": "integer",
          "max_capacity": "integer",
          "reason": "string"
        },
        "retention": "latest_value",
        "source": "conveyor"
      },
      {
        "event_id": "conveyor.capacity_available",
        "kind": "device_signal",
        "payload_schema": {
          "conveyor_id": "string",
          "current_load": "integer",
          "resume_threshold": "integer"
        },
        "retention": "event_log",
        "source": "conveyor"
      },
      {
        "event_id": "observation.deadlock_detected",
        "kind": "observation",
        "payload_schema": {
          "reason": "string",
          "wait_chain": "array"
        },
        "retention": "event_log",
        "source": "runtime"
      },
      {
        "event_id": "global.process_done",
        "kind": "global_event",
        "payload_schema": {
          "scene_id": "string"
        },
        "retention": "event_log",
        "source": "runtime"
      },
      {
        "event_id": "source.material_available",
        "kind": "device_signal",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log",
        "source": "source_station_1"
      },
      {
        "event_id": "workpiece.processing_position_ready",
        "kind": "global_event",
        "payload_schema": {
          "material_id": "string",
          "conveyor_id": "string",
          "point_id": "string"
        },
        "retention": "event_log",
        "source": "runtime"
      },
      {
        "event_id": "robot.processing_done",
        "kind": "device_signal",
        "payload_schema": {
          "robot_id": "string",
          "material_id": "string"
        },
        "retention": "event_log",
        "source": "robot_arm"
      },
      {
        "event_id": "upstream.pause",
        "kind": "control_event",
        "payload_schema": {
          "conveyor_id": "string",
          "reason": "string"
        },
        "retention": "latest_value",
        "source": "scheduler"
      },
      {
        "event_id": "upstream.resume",
        "kind": "control_event",
        "payload_schema": {
          "conveyor_id": "string"
        },
        "retention": "event_log",
        "source": "scheduler"
      }
    ],
    "topics": [
      {
        "topic_id": "robot_task_request",
        "description": "把可执行作业广播给候选机械臂规则。",
        "delivery": "broadcast"
      },
      {
        "topic_id": "backpressure",
        "description": "传送带 blocked / capacity_available 后广播给上游暂停或恢复规则。",
        "delivery": "broadcast"
      }
    ],
    "subscriptions": {
      "robot_task_request": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "robot_accepts_task_request",
          "message_event_id": "robot.pick_request",
          "filter": "device_states.robot_1 == idle",
          "payload_template": {
            "robot_id": "robot_1"
          }
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "robot_accepts_task_request",
          "message_event_id": "robot.pick_request",
          "filter": "device_states.robot_2 == idle",
          "payload_template": {
            "robot_id": "robot_2"
          }
        }
      ],
      "backpressure": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "pause_upstream_when_conveyor_blocked",
          "message_event_id": "conveyor.blocked",
          "filter": "event.event_id == conveyor.blocked",
          "payload_template": "source_event.payload"
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "resume_upstream_when_capacity_available",
          "message_event_id": "conveyor.capacity_available",
          "filter": "event.event_id == conveyor.capacity_available",
          "payload_template": "source_event.payload"
        }
      ]
    },
    "routes": [
      {
        "route_id": "route_process_done_to_completion_checker",
        "from": "global.process_done",
        "to": {
          "type": "runtime",
          "id": "CompletionChecker"
        },
        "delivery": "internal"
      },
      {
        "route_id": "route_material_arrived_to_conveyor_accept",
        "from": "conveyor.material_arrived",
        "to": {
          "type": "rule",
          "id": "accept_material_to_first_available_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_stop_point_occupied_to_advance",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "advance_material_to_next_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_stop_point_released_to_capacity",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "emit_capacity_available_when_stop_point_released"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_blocked_to_backpressure_topic",
        "from": "conveyor.blocked",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
          "path": "event_bus.subscriptions.backpressure"
        }
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
          "path": "event_bus.subscriptions.backpressure"
        }
      }
    ],
    "backpressure_bindings": [
      {
        "conveyor_id": "main_conveyor_1",
        "affected_upstream": "upstream devices from process flow"
      }
    ]
  },
