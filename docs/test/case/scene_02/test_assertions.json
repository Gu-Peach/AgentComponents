{
  "case_id": "scene_02_multi_robot_farthest_idle_sorting_line",
  "schema_type": "BenchmarkAssertions",
  "version": "0.1.0",
  "source": {
    "kind": "manual_assertion",
    "image": "docs/business/test/2.png"
  },
  "must_have_modules": [
    "pallet_generation",
    "farthest_idle_pallet_routing",
    "three_robot_sorting",
    "robot_output_conveying"
  ],
  "must_have_events": [
    "runtime.sim_start",
    "conveyor.material_arrived",
    "conveyor.stop_point_occupied",
    "conveyor.stop_point_released",
    "conveyor.blocked",
    "conveyor.capacity_available",
    "observation.deadlock_detected",
    "global.process_done",
    "pallet_source.pallet_ready",
    "pallet.arrived_at_robot_station",
    "robot.pick_request",
    "global.workpiece_claimed",
    "robot.pick_done",
    "main_line.all_robots_busy",
    "main_line.robot_available",
    "upstream.pause",
    "upstream.resume"
  ],
  "must_have_topics": [
    "robot_task_request",
    "backpressure"
  ],
  "must_have_behavior_rules": [
    "accept_material_to_first_available_stop_point",
    "advance_material_to_next_stop_point",
    "wait_when_next_stop_point_occupied",
    "release_material_when_downstream_available",
    "emit_blocked_when_no_stop_point_available",
    "emit_capacity_available_when_stop_point_released",
    "pause_upstream_when_conveyor_blocked",
    "resume_upstream_when_capacity_available",
    "source_generates_loaded_pallet",
    "route_pallet_to_farthest_idle_robot",
    "pause_source_when_all_robots_busy",
    "resume_source_when_robot_available",
    "robot_claims_part_from_assigned_pallet",
    "claimed_part_starts_robot_pick"
  ],
  "must_have_policies": [
    "capacity_threshold",
    "deadlock_detection",
    "deterministic_priority",
    "downstream_release",
    "nearest_available_stop_point",
    "queue_wait",
    "resource_lock",
    "shared_pool_claim"
  ],
  "must_have_state_variables": [
    "workpiece_pool",
    "material_locations",
    "device_states",
    "signal_values",
    "resource_locks",
    "active_actions",
    "conveyor_stop_points",
    "conveyor_occupancy",
    "conveyor_queues",
    "conveyor_loads"
  ],
  "must_have_completion_conditions": [
    "all planned pallets processed or exited",
    "all pallet_workpiece_pools remaining_count == 0",
    "all conveyor_occupancy stop points are empty",
    "active_actions.empty == true"
  ],
  "forbidden_schema_types": [
    "SimPlan",
    "ExecutableSimGraph",
    "TransportPlan"
  ],
  "forbidden_rule_forms": [
    "when_event / when_state / if / then_*",
    "move material directly to conveyor.exit"
  ],
  "minimum_validation_expectations": [
    "SceneBehaviorGraph contains required top-level sections",
    "event_bus routes reference registered events",
    "behavior_rules use trigger / guard / policy / action",
    "conveyor scenes include stop-point-aware state variables"
  ]
}
