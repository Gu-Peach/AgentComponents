{
  "schema_id": "scene_behavior_graph_scene_02_multi_robot_farthest_idle_sorting_line_v0_1",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.1.0",
  "name": "Scene 02：多机械臂远端优先托盘分拣线 Golden SceneBehaviorGraph",
  "description": "左侧出料口间隔输出承载 12 个工件的托盘，托盘沿长主传送带移动到三台机械臂工位；系统优先把新托盘送到最远端空闲机械臂，三台机械臂全忙时主线和出料口暂停。",
  "source": {
    "kind": "benchmark_case",
    "image": "docs/business/test/2.png",
    "case": "docs/test/case/scene_02"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark golden answer",
  "references": [
    "docs/business/SimulationSchema/README.md",
    "docs/business/SimulationSchema/1.DeviceSpec/",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json"
  ],
  "notes": [
    "当前 golden 只使用新方案，不包含 SimPlan。",
    "传送带场景必须使用停留点感知运输。"
  ],
  "goal": {
    "natural_language": "场景从左到右包括托盘出料口、承载 12 个工件的托盘、长主传送带、三台机械臂，以及每台机械臂对应的一条出料传送带。出料口按节拍输出托盘，托盘进入主传送带后按停留点逐步前进。调度策略优先选择最远端空闲机械臂工位：如果 robot_3 空闲，托盘优先送到 robot_3；否则尝试 robot_2，再尝试 robot_1。当三台机械臂均忙时，主传送带保持当前停留点占用并停止继续放行，上游出料口暂停产生新托盘。机械臂从到位托盘中处理 12 个工件，并放入各自对应的出料传送带。每条出料传送带都按停留点容量处理 backpressure：满载或无停留点时发出 conveyor.blocked，容量恢复后发出 conveyor.capacity_available。空托盘沿主线继续到末端并离开系统。",
    "assumptions": [
      "每个托盘默认包含 12 个同类工件。",
      "空托盘到达主传送带末端后离开系统。",
      "三台机械臂各自负责一个固定出料传送带。"
    ],
    "open_questions": [
      "是否需要持续生成无限托盘，还是只验证固定数量托盘？",
      "robot_3、robot_2、robot_1 的优先级是否始终固定？"
    ]
  },
  "modules": [
    {
      "module_id": "pallet_generation",
      "mode": "periodic",
      "devices": [
        "pallet_source_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "pallet_source.pallet_ready"
    },
    {
      "module_id": "farthest_idle_pallet_routing",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "main_conveyor_1"
      ],
      "start_event": "pallet_source.pallet_ready",
      "stop_condition": "all generated pallets assigned or exited"
    },
    {
      "module_id": "three_robot_sorting",
      "mode": "parallel_continuous",
      "devices": [
        "robot_1",
        "robot_2",
        "robot_3"
      ],
      "start_event": "pallet.arrived_at_robot_station",
      "stop_condition": "all assigned pallet workpieces processed"
    },
    {
      "module_id": "robot_output_conveying",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "robot_1_out_conveyor",
        "robot_2_out_conveyor",
        "robot_3_out_conveyor"
      ],
      "start_event": "robot.pick_done",
      "stop_condition": "all output conveyor loads and stop points are empty"
    }
  ],
