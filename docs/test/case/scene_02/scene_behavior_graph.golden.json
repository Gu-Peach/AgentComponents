        },
        "retention": "event_log",
        "source": "scheduler"
      },
      {
        "event_id": "upstream.pause",
        "kind": "control_event",
        "payload_schema": {
          "conveyor_id": "string",
          "reason": "string"
        },
        "retention": "latest_value",
        "source": "scheduler"
      },
      {
        "event_id": "upstream.resume",
        "kind": "control_event",
        "payload_schema": {
          "conveyor_id": "string"
        },
        "retention": "event_log",
        "source": "scheduler"
      }
    ],
    "topics": [
      {
        "topic_id": "robot_task_request",
        "description": "把可执行作业广播给候选机械臂规则。",
        "delivery": "broadcast"
      },
      {
        "topic_id": "backpressure",
        "description": "传送带 blocked / capacity_available 后广播给上游暂停或恢复规则。",
        "delivery": "broadcast"
      }
    ],
    "subscriptions": {
      "robot_task_request": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "robot_accepts_task_request",
          "message_event_id": "robot.pick_request",
          "filter": "device_states.robot_1 == idle",
          "payload_template": {
            "robot_id": "robot_1"
          }
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "robot_accepts_task_request",
          "message_event_id": "robot.pick_request",
          "filter": "device_states.robot_2 == idle",
          "payload_template": {
            "robot_id": "robot_2"
          }
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "robot_accepts_task_request",
          "message_event_id": "robot.pick_request",
          "filter": "device_states.robot_3 == idle",
          "payload_template": {
            "robot_id": "robot_3"
          }
        }
      ],
      "backpressure": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "pause_upstream_when_conveyor_blocked",
          "message_event_id": "conveyor.blocked",
          "filter": "event.event_id == conveyor.blocked",
          "payload_template": "source_event.payload"
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "resume_upstream_when_capacity_available",
          "message_event_id": "conveyor.capacity_available",
          "filter": "event.event_id == conveyor.capacity_available",
          "payload_template": "source_event.payload"
        }
      ]
    },
    "routes": [
      {
        "route_id": "route_process_done_to_completion_checker",
        "from": "global.process_done",
        "to": {
          "type": "runtime",
          "id": "CompletionChecker"
        },
        "delivery": "internal"
      },
      {
        "route_id": "route_material_arrived_to_conveyor_accept",
        "from": "conveyor.material_arrived",
        "to": {
          "type": "rule",
          "id": "accept_material_to_first_available_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_stop_point_occupied_to_advance",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "advance_material_to_next_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_stop_point_released_to_capacity",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "emit_capacity_available_when_stop_point_released"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_blocked_to_backpressure_topic",
        "from": "conveyor.blocked",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
          "path": "event_bus.subscriptions.backpressure"
        }
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast",
        "target_resolver": {
          "type": "subscription",
          "path": "event_bus.subscriptions.backpressure"
        }
      },
      {
        "route_id": "route_robot_pick_done_to_conveyor_arrival",
        "from": "robot.pick_done",
        "to": {
          "type": "rule",
          "id": "accept_material_to_first_available_stop_point"
        },
        "delivery": "direct"
      }
    ],
    "backpressure_bindings": [
