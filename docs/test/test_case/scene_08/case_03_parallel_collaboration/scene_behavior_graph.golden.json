        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_occupied_to_release_material_when_downstream_available",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "release_material_when_downstream_available"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_released_to_emit_capacity_available_when_stop_point_released",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "emit_capacity_available_when_stop_point_released"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_runtime_sim_start_to_produce_part_to_part_conveyor",
        "from": "runtime.sim_start",
        "to": {
          "type": "rule",
          "id": "produce_part_to_part_conveyor"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_runtime_sim_start_to_move_empty_pallet_to_loading_position",
        "from": "runtime.sim_start",
        "to": {
          "type": "rule",
          "id": "move_empty_pallet_to_loading_position"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_loading_preconditions_met_to_robot_loads_part_into_pallet",
        "from": "loading.preconditions_met",
        "to": {
          "type": "rule",
          "id": "robot_loads_part_into_pallet"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_pallet_target_count_reached_to_release_loaded_pallet",
        "from": "pallet.target_count_reached",
        "to": {
          "type": "rule",
          "id": "release_loaded_pallet"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_global_workpiece_claimed_to_prevent_duplicate_shared_resource_claim",
        "from": "global.workpiece_claimed",
        "to": {
          "type": "rule",
          "id": "prevent_duplicate_shared_resource_claim"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_blocked_to_backpressure_topic",
        "from": "conveyor.blocked",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      }
    ]
  },
