      {
        "event_id": "robot.pick_done",
        "kind": "device_signal",
        "source": "robot_arm",
        "description": "机械臂抓取放置动作完成",
        "payload_schema": {
          "robot_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "part_source_1.material_ready",
        "kind": "device_signal",
        "source": "part_source_1",
        "description": "part_source_1.material_ready 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "part_conveyor_1.part_ready",
        "kind": "device_signal",
        "source": "part_conveyor_1",
