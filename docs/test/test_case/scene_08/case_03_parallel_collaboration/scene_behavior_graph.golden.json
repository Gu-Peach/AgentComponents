        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "loading.preconditions_met",
        "kind": "device_signal",
        "source": "loading",
        "description": "loading.preconditions_met 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "pallet.slot_loaded",
        "kind": "device_signal",
        "source": "pallet",
        "description": "pallet.slot_loaded 场景事件",
