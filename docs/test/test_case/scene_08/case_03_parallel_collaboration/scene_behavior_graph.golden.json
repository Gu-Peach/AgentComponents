{
  "schema_id": "scene_08_case_03_scene_behavior_graph_golden_v0_2",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.2.0",
  "name": "scene_08_case_03 parallel_collaboration golden",
  "description": "物料与托盘同步到位装载 的正式 benchmark 标准行为图。",
  "source": {
    "kind": "benchmark_golden",
    "input": "test/test_case/scene_08/case_03_parallel_collaboration/input.md",
    "scene_image": "docs/business/test/8.png",
    "raw_description_summary_source": "docs/test/case/scene_08/normalized_case.md#raw_description_summary"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark",
  "references": [
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/template.json",
    "docs/business/SimulationSchema/README.md"
  ],
  "notes": [
    "判卷对象只看最终 SceneBehaviorGraph。",
    "不使用旧中间 schema 字段。"
  ],
  "goal": {
    "natural_language": "我希望图中的可并行设备一起协作，谁空闲谁先处理，但共享工件、交接位或出口传送带不能被两个动作同时占用。",
    "assumptions": [
      "图片显示上方物料侧传送带、下方托盘侧滚筒传送带、左侧空托盘和右侧装载机械臂。",
      "所有传送带停留点由 DeviceSpec stop_point_model 与 SceneDocument 实例参数派生。"
    ]
  },
  "modules": [
    {
      "module_id": "part_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "part_source_1",
        "part_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "part_conveyor_1.part_ready",
      "stop_condition": "part available at load position"
    },
    {
      "module_id": "pallet_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "pallet_1",
        "pallet_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "pallet_conveyor_1.pallet_ready",
      "stop_condition": "empty pallet at load position"
    },
    {
      "module_id": "synchronized_loading",
      "mode": "sequential",
      "transport_model": "not_applicable",
      "devices": [
        "robot_1",
        "pallet_1"
      ],
      "start_event": "loading.preconditions_met",
      "complete_event": "pallet.slot_loaded",
      "stop_condition": "part and pallet synchronized"
    },
    {
      "module_id": "loaded_pallet_output",
      "mode": "sequential",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "pallet_conveyor_1"
      ],
      "start_event": "pallet.target_count_reached",
      "complete_event": "global.pallet_loaded",
      "stop_condition": "loaded pallet exits"
    }
  ],
  "event_bus": {
    "events": [
      {
        "event_id": "runtime.sim_start",
        "kind": "global_event",
        "source": "runtime",
        "description": "仿真开始事件",
        "payload_schema": {},
        "retention": "checkpoint_only"
      },
      {
        "event_id": "observation.deadlock_detected",
        "kind": "observation",
        "source": "runtime",
        "description": "没有可执行行为且完成条件未满足",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "observation.invalid_requirement",
        "kind": "observation",
        "source": "runtime",
        "description": "输入目标与场景事实或设备能力冲突",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
