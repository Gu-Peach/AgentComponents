  "behavior_rules": [
    {
      "rule_id": "accept_material_to_first_available_stop_point",
      "module_id": "store_with_lift",
      "description": "新物料进入传送带时写入入口侧最近可用停留点。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.material_arrived"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].blocked == false",
          "entry stop point is available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_stop_point_selection",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "material_id": "trigger.payload.material_id"
        },
        "bind_outputs_to": {
          "point_id": "action.payload.target_stop_point"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "accept_material",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "target_stop_point": "policy.point_id"
        }
      }
    },
    {
      "rule_id": "advance_material_to_next_stop_point",
      "module_id": "store_with_lift",
      "description": "前方停留点可用时，物料沿出口方向推进一个停留点。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "next stop point exists",
          "next stop point is empty",
          "conveyor_loads[trigger.payload.conveyor_id].blocked == false"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_stop_point_selection",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "advance_to_next_stop_point",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "from_point_id": "trigger.payload.point_id",
          "to_point_id": "policy.point_id"
        }
      }
    },
    {
      "rule_id": "wait_when_next_stop_point_occupied",
      "module_id": "store_with_lift",
      "description": "前方停留点或下游不可用时，将物料留在当前位置并进入等待队列。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "next stop point occupied or downstream unavailable"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_queue_wait",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "update_state",
        "payload": {
          "append": "trigger.payload.material_id",
          "to": "conveyor_queues[trigger.payload.conveyor_id].waiting_materials"
        }
      }
    },
    {
      "rule_id": "release_material_when_downstream_available",
      "module_id": "store_with_lift",
      "description": "出口停留点有物料且下游可接收时释放物料。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "trigger.payload.point_id role == exit",
          "downstream available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "downstream_release",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "release_material",
        "payload": {
          "material_id": "trigger.payload.material_id"
        }
      }
    },
    {
      "rule_id": "emit_blocked_when_no_stop_point_available",
      "module_id": "store_with_lift",
      "description": "无可用停留点或达到容量上限时发出阻塞观测。",
      "trigger": {
        "type": "state_change",
        "state": "conveyor_loads[*].current_load >= conveyor_loads[*].max_capacity"
      },
      "guard": {
        "all": [
          "no available stop point or current_load >= max_capacity"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.blocked",
        "payload": {
          "conveyor_id": "state.conveyor_id",
          "reason": "capacity_or_downstream_blocked"
        }
      }
    },
    {
      "rule_id": "emit_capacity_available_when_stop_point_released",
      "module_id": "store_with_lift",
      "description": "停留点释放且负载低于恢复阈值时发出容量恢复事件。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_released"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].current_load <= conveyor_loads[trigger.payload.conveyor_id].resume_threshold"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.capacity_available",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      }
    },
    {
      "rule_id": "source_feeds_inbound_conveyor",
      "module_id": "inbound_feed",
      "description": "入口来源将物料送入入库传送带。",
      "trigger": {
        "type": "event",
        "event_id": "runtime.sim_start"
      },
      "guard": {
        "all": [
          "inbound_conveyor_1 entry available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "resource_lock",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "source_station_1",
        "behavior_id": "produce_material",
        "payload": {
          "material_id": "next_part"
        }
      }
    },
    {
      "rule_id": "inbound_lift_accepts_material",
      "module_id": "store_with_lift",
      "description": "入口升降台从入库传送带接收物料。",
      "trigger": {
        "type": "event",
        "event_id": "inbound_conveyor_1.part_ready"
      },
      "guard": {
        "all": [
          "device_states.inbound_lift_1 == idle",
          "exists free storage cell"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "resource_lock",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "inbound_lift_1",
        "behavior_id": "accept_material",
        "payload": {
          "material_id": "trigger.payload.material_id"
        }
      }
    },
    {
      "rule_id": "reserve_storage_cell",
      "module_id": "store_with_lift",
      "description": "入库前先 reserve 空闲库位。",
      "trigger": {
        "type": "event",
        "event_id": "inbound_conveyor_1.part_ready"
      },
      "guard": {
        "all": [
          "storage_cells has null cell"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "storage_slot_selection",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "storage_rack_1",
        "behavior_id": "reserve_cell",
        "payload": {
          "cell_id": "policy.cell_id"
        }
      }
    },
    {
      "rule_id": "store_material_to_reserved_cell",
      "module_id": "store_with_lift",
      "description": "升降台移动到目标层后将物料放入已预留库位。",
      "trigger": {
        "type": "event",
        "event_id": "storage.cell_reserved"
      },
      "guard": {
        "all": [
          "device_states.inbound_lift_1 != error"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "resource_lock",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "storage_rack_1",
        "behavior_id": "store_to_cell",
        "payload": {
          "cell_id": "trigger.payload.cell_id"
        }
      }
    },
    {
      "rule_id": "retrieve_fifo_cell",
      "module_id": "retrieve_with_lift",
      "description": "出库按 FIFO 选择已存储库位释放。",
      "trigger": {
        "type": "event",
        "event_id": "storage.release_requested"
      },
      "guard": {
        "all": [
          "storage_cells has occupied cell",
          "device_states.outbound_lift_1 == idle"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "storage_release_selection",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "storage_rack_1",
        "behavior_id": "release_from_cell",
