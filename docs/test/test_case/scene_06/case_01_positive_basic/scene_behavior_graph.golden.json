          "type": "rule",
          "id": "release_material_when_downstream_available"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_released_to_emit_capacity_available_when_stop_point_released",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "emit_capacity_available_when_stop_point_released"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_runtime_sim_start_to_source_feeds_inbound_conveyor",
        "from": "runtime.sim_start",
        "to": {
          "type": "rule",
          "id": "source_feeds_inbound_conveyor"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_inbound_conveyor_1_part_ready_to_inbound_lift_accepts_material",
        "from": "inbound_conveyor_1.part_ready",
        "to": {
          "type": "rule",
          "id": "inbound_lift_accepts_material"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_inbound_conveyor_1_part_ready_to_reserve_storage_cell",
        "from": "inbound_conveyor_1.part_ready",
        "to": {
          "type": "rule",
          "id": "reserve_storage_cell"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_storage_cell_reserved_to_store_material_to_reserved_cell",
        "from": "storage.cell_reserved",
        "to": {
          "type": "rule",
          "id": "store_material_to_reserved_cell"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_storage_release_requested_to_retrieve_fifo_cell",
        "from": "storage.release_requested",
        "to": {
          "type": "rule",
          "id": "retrieve_fifo_cell"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_outbound_lift_1_material_ready_to_outbound_lift_releases_to_conveyor",
        "from": "outbound_lift_1.material_ready",
        "to": {
          "type": "rule",
          "id": "outbound_lift_releases_to_conveyor"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_blocked_to_backpressure_topic",
        "from": "conveyor.blocked",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      }
    ]
  },
