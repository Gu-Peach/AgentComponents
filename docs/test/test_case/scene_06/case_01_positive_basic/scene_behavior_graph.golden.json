{
  "schema_id": "scene_06_case_01_scene_behavior_graph_golden_v0_2",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.2.0",
  "name": "scene_06_case_01 positive_basic golden",
  "description": "升降台入库出库仓储线 的正式 benchmark 标准行为图。",
  "source": {
    "kind": "benchmark_golden",
    "input": "test/test_case/scene_06/case_01_positive_basic/input.md",
    "scene_image": "docs/business/test/6.png",
    "raw_description_summary_source": "docs/test/case/scene_06/normalized_case.md#raw_description_summary"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark",
  "references": [
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/template.json",
    "docs/business/SimulationSchema/README.md"
  ],
  "notes": [
    "判卷对象只看最终 SceneBehaviorGraph。",
    "不使用旧中间 schema 字段。"
  ],
  "goal": {
    "natural_language": "请按图里的布局跑一遍升降台入库出库仓储线，让物料按场景描述完成基础流程，传送带要按停留点排队，不要把物料瞬移到终点。",
    "assumptions": [
      "图片显示入口来源和短传送带、左侧入库升降台、中间多层货架、右侧出库升降台和末端传送带。",
      "所有传送带停留点由 DeviceSpec stop_point_model 与 SceneDocument 实例参数派生。"
    ]
  },
  "modules": [
    {
      "module_id": "inbound_feed",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "source_station_1",
        "inbound_conveyor_1"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "inbound_conveyor_1.part_ready",
      "stop_condition": "inbound conveyor supplies lift"
    },
    {
      "module_id": "store_with_lift",
      "mode": "sequential",
      "transport_model": "not_applicable",
      "devices": [
        "inbound_lift_1",
        "storage_rack_1"
      ],
      "start_event": "inbound_conveyor_1.part_ready",
      "complete_event": "storage_rack_1.stored",
      "stop_condition": "inbound material stored"
    },
    {
      "module_id": "retrieve_with_lift",
      "mode": "sequential",
      "transport_model": "not_applicable",
      "devices": [
        "storage_rack_1",
        "outbound_lift_1"
      ],
      "start_event": "storage.release_requested",
      "complete_event": "outbound_lift_1.material_ready",
      "stop_condition": "stored material released"
    },
    {
      "module_id": "outbound_transport",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "outbound_conveyor_1"
      ],
      "start_event": "outbound_lift_1.material_ready",
      "complete_event": "outbound_conveyor_1.material_released",
      "stop_condition": "outbound conveyor drains"
    }
  ],
  "event_bus": {
    "events": [
      {
        "event_id": "runtime.sim_start",
        "kind": "global_event",
        "source": "runtime",
        "description": "仿真开始事件",
        "payload_schema": {},
        "retention": "checkpoint_only"
      },
      {
        "event_id": "observation.deadlock_detected",
        "kind": "observation",
        "source": "runtime",
        "description": "没有可执行行为且完成条件未满足",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "observation.invalid_requirement",
        "kind": "observation",
        "source": "runtime",
        "description": "输入目标与场景事实或设备能力冲突",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.material_arrived",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料到达传送带入口或停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.stop_point_occupied",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料占用某个传送带停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.stop_point_released",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料释放某个传送带停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.blocked",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "传送带因容量或下游不可接收进入阻塞",
        "payload_schema": {
          "conveyor_id": "string",
          "reason": "string"
        },
        "retention": "latest_value"
      },
      {
        "event_id": "conveyor.capacity_available",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "传送带释放容量后恢复可接收",
        "payload_schema": {
          "conveyor_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "source_station_1.material_ready",
        "kind": "device_signal",
        "source": "source_station_1",
        "description": "source_station_1.material_ready 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "inbound_conveyor_1.part_ready",
        "kind": "device_signal",
        "source": "inbound_conveyor_1",
        "description": "inbound_conveyor_1.part_ready 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "storage.cell_reserved",
        "kind": "device_signal",
        "source": "storage",
        "description": "storage.cell_reserved 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "storage_rack_1.stored",
        "kind": "device_signal",
        "source": "storage_rack_1",
        "description": "storage_rack_1.stored 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "storage.release_requested",
        "kind": "device_signal",
        "source": "storage",
        "description": "storage.release_requested 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "outbound_lift_1.material_ready",
        "kind": "device_signal",
        "source": "outbound_lift_1",
        "description": "outbound_lift_1.material_ready 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "global.storage_cycle_done",
        "kind": "global_event",
        "source": "global",
        "description": "global.storage_cycle_done 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      }
    ],
    "topics": [
      {
        "topic_id": "backpressure",
        "description": "传送带阻塞与恢复广播",
        "delivery": "broadcast"
      }
    ],
    "subscriptions": {
      "backpressure": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "emit_blocked_when_no_stop_point_available",
          "message_event_id": "conveyor.blocked",
          "filter": "conveyor_loads[conveyor_id].blocked == true",
          "payload_template": {
            "conveyor_id": "event.payload.conveyor_id"
          }
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "emit_capacity_available_when_stop_point_released",
          "message_event_id": "conveyor.capacity_available",
          "filter": "conveyor_loads[conveyor_id].blocked == false",
          "payload_template": {
            "conveyor_id": "event.payload.conveyor_id"
          }
        }
      ]
    },
    "routes": [
      {
        "route_id": "route_conveyor_material_arrived_to_accept_material_to_first_available_stop_point",
        "from": "conveyor.material_arrived",
        "to": {
