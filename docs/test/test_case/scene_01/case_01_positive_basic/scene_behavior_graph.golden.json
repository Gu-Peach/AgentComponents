{
  "schema_id": "scene_01_case_01_scene_behavior_graph_golden_v0_2",
  "schema_type": "SceneBehaviorGraph",
  "version": "0.2.0",
  "name": "scene_01_case_01 positive_basic golden",
  "description": "托盘分拣停留点传送线 的正式 benchmark 标准行为图。",
  "source": {
    "kind": "benchmark_golden",
    "input": "test/test_case/scene_01/case_01_positive_basic/input.md",
    "scene_image": "docs/business/test/1.png",
    "raw_description_summary_source": "docs/test/case/scene_01/normalized_case.md#raw_description_summary"
  },
  "created_for": "SceneBehaviorGraph Agent benchmark",
  "references": [
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/schema.json",
    "docs/business/SimulationSchema/4.SceneBehaviorGraph/template.json",
    "docs/business/SimulationSchema/README.md"
  ],
  "notes": [
    "判卷对象只看最终 SceneBehaviorGraph。",
    "不使用旧中间 schema 字段。"
  ],
  "goal": {
    "natural_language": "请按图里的布局跑一遍托盘分拣停留点传送线，让物料按场景描述完成基础流程，传送带要按停留点排队，不要把物料瞬移到终点。",
    "assumptions": [
      "图片显示左侧托盘、水平主传送带、两台机械臂覆盖托盘分拣位，以及右侧上下两条出料传送带。",
      "所有传送带停留点由 DeviceSpec stop_point_model 与 SceneDocument 实例参数派生。"
    ]
  },
  "modules": [
    {
      "module_id": "pallet_transport",
      "mode": "sequential",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "pallet_1",
        "main_conveyor_1",
        "main_conveyor_2"
      ],
      "start_event": "runtime.sim_start",
      "complete_event": "main_conveyor_2.pallet_ready",
      "stop_condition": "pallet_1 at sorting_position"
    },
    {
      "module_id": "parallel_robot_sorting",
      "mode": "parallel_continuous",
      "transport_model": "not_applicable",
      "devices": [
        "robot_1",
        "robot_2"
      ],
      "start_event": "main_conveyor_2.pallet_ready",
      "complete_event": "global.sorting_done",
      "stop_condition": "workpiece_pool.remaining_parts.empty == true"
    },
    {
      "module_id": "output_conveying",
      "mode": "continuous",
      "transport_model": "stop_point_buffered_transport",
      "devices": [
        "upper_out_conveyor_1",
        "lower_out_conveyor_1"
      ],
      "start_event": "robot.pick_done",
      "complete_event": "output_conveyor.material_released",
      "stop_condition": "all output conveyors empty"
    }
  ],
  "event_bus": {
    "events": [
      {
        "event_id": "runtime.sim_start",
        "kind": "global_event",
        "source": "runtime",
        "description": "仿真开始事件",
        "payload_schema": {},
        "retention": "checkpoint_only"
      },
      {
        "event_id": "observation.deadlock_detected",
        "kind": "observation",
        "source": "runtime",
        "description": "没有可执行行为且完成条件未满足",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "observation.invalid_requirement",
        "kind": "observation",
        "source": "runtime",
        "description": "输入目标与场景事实或设备能力冲突",
        "payload_schema": {
          "reason": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.material_arrived",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料到达传送带入口或停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.stop_point_occupied",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料占用某个传送带停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.stop_point_released",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "物料释放某个传送带停留点",
        "payload_schema": {
          "conveyor_id": "string",
          "point_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "conveyor.blocked",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "传送带因容量或下游不可接收进入阻塞",
        "payload_schema": {
          "conveyor_id": "string",
          "reason": "string"
        },
        "retention": "latest_value"
      },
      {
        "event_id": "conveyor.capacity_available",
        "kind": "device_signal",
        "source": "conveyor",
        "description": "传送带释放容量后恢复可接收",
        "payload_schema": {
          "conveyor_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "robot.pick_request",
        "kind": "control_event",
        "source": "scheduler",
        "description": "请求空闲机械臂执行抓取或搬运动作",
        "payload_schema": {
          "candidate_robots": "array",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "global.workpiece_claimed",
        "kind": "global_event",
        "source": "policy",
        "description": "共享物料或工位被某个执行单元成功 claim",
        "payload_schema": {
          "robot_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "robot.pick_done",
        "kind": "device_signal",
        "source": "robot_arm",
        "description": "机械臂抓取放置动作完成",
        "payload_schema": {
          "robot_id": "string",
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "main_conveyor_2.pallet_ready",
        "kind": "device_signal",
        "source": "main_conveyor_2",
        "description": "main_conveyor_2.pallet_ready 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "output_conveyor.material_arrived",
        "kind": "device_signal",
        "source": "output_conveyor",
        "description": "output_conveyor.material_arrived 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "robot.pause_pick",
        "kind": "device_signal",
        "source": "robot",
        "description": "robot.pause_pick 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "robot.resume_pick",
        "kind": "device_signal",
        "source": "robot",
        "description": "robot.resume_pick 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      },
      {
        "event_id": "global.sorting_done",
        "kind": "global_event",
        "source": "global",
        "description": "global.sorting_done 场景事件",
        "payload_schema": {
          "material_id": "string"
        },
        "retention": "event_log"
      }
    ],
    "topics": [
      {
        "topic_id": "backpressure",
        "description": "传送带阻塞与恢复广播",
        "delivery": "broadcast"
      }
    ],
    "subscriptions": {
      "backpressure": [
        {
          "subscriber_type": "rule",
          "subscriber_id": "emit_blocked_when_no_stop_point_available",
          "message_event_id": "conveyor.blocked",
          "filter": "conveyor_loads[conveyor_id].blocked == true",
          "payload_template": {
            "conveyor_id": "event.payload.conveyor_id"
          }
        },
        {
          "subscriber_type": "rule",
          "subscriber_id": "emit_capacity_available_when_stop_point_released",
          "message_event_id": "conveyor.capacity_available",
          "filter": "conveyor_loads[conveyor_id].blocked == false",
          "payload_template": {
            "conveyor_id": "event.payload.conveyor_id"
          }
        }
      ]
    },
    "routes": [
      {
        "route_id": "route_conveyor_material_arrived_to_accept_material_to_first_available_stop_point",
        "from": "conveyor.material_arrived",
        "to": {
          "type": "rule",
          "id": "accept_material_to_first_available_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_occupied_to_advance_material_to_next_stop_point",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "advance_material_to_next_stop_point"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_occupied_to_wait_when_next_stop_point_occupied",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "wait_when_next_stop_point_occupied"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_occupied_to_release_material_when_downstream_available",
        "from": "conveyor.stop_point_occupied",
        "to": {
          "type": "rule",
          "id": "release_material_when_downstream_available"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_released_to_emit_capacity_available_when_stop_point_released",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "emit_capacity_available_when_stop_point_released"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_runtime_sim_start_to_start_pallet_transport",
        "from": "runtime.sim_start",
        "to": {
          "type": "rule",
          "id": "start_pallet_transport"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_stop_point_released_to_transfer_pallet_to_sorting_position",
        "from": "conveyor.stop_point_released",
        "to": {
          "type": "rule",
          "id": "transfer_pallet_to_sorting_position"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_main_conveyor_2_pallet_ready_to_idle_robot_requests_workpiece",
        "from": "main_conveyor_2.pallet_ready",
        "to": {
          "type": "rule",
          "id": "idle_robot_requests_workpiece"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_global_workpiece_claimed_to_claimed_workpiece_starts_pick",
        "from": "global.workpiece_claimed",
        "to": {
          "type": "rule",
          "id": "claimed_workpiece_starts_pick"
        },
        "delivery": "direct"
      },
      {
        "route_id": "route_conveyor_blocked_to_backpressure_topic",
        "from": "conveyor.blocked",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      },
      {
        "route_id": "route_capacity_available_to_backpressure_topic",
        "from": "conveyor.capacity_available",
        "to": {
          "type": "topic",
          "id": "backpressure"
        },
        "delivery": "broadcast"
      }
    ]
  },
