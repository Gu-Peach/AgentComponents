  "behavior_rules": [
    {
      "rule_id": "accept_material_to_first_available_stop_point",
      "module_id": "mainline_dispatch",
      "description": "新物料进入传送带时写入入口侧最近可用停留点。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.material_arrived"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].blocked == false",
          "entry stop point is available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_stop_point_selection",
        "inputs": {
          "conveyor_id": "trigger.payload.conveyor_id",
          "material_id": "trigger.payload.material_id"
        },
        "bind_outputs_to": {
          "point_id": "action.payload.target_stop_point"
        }
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "accept_material",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "target_stop_point": "policy.point_id"
        }
      }
    },
    {
      "rule_id": "advance_material_to_next_stop_point",
      "module_id": "mainline_dispatch",
      "description": "前方停留点可用时，物料沿出口方向推进一个停留点。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "next stop point exists",
          "next stop point is empty",
          "conveyor_loads[trigger.payload.conveyor_id].blocked == false"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_stop_point_selection",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "advance_to_next_stop_point",
        "payload": {
          "material_id": "trigger.payload.material_id",
          "from_point_id": "trigger.payload.point_id",
          "to_point_id": "policy.point_id"
        }
      }
    },
    {
      "rule_id": "wait_when_next_stop_point_occupied",
      "module_id": "mainline_dispatch",
      "description": "前方停留点或下游不可用时，将物料留在当前位置并进入等待队列。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "next stop point occupied or downstream unavailable"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "conveyor_queue_wait",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "update_state",
        "payload": {
          "append": "trigger.payload.material_id",
          "to": "conveyor_queues[trigger.payload.conveyor_id].waiting_materials"
        }
      }
    },
    {
      "rule_id": "release_material_when_downstream_available",
      "module_id": "mainline_dispatch",
      "description": "出口停留点有物料且下游可接收时释放物料。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_occupied"
      },
      "guard": {
        "all": [
          "trigger.payload.point_id role == exit",
          "downstream available"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "downstream_release",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "trigger.payload.conveyor_id",
        "behavior_id": "release_material",
        "payload": {
          "material_id": "trigger.payload.material_id"
        }
      }
    },
    {
      "rule_id": "emit_blocked_when_no_stop_point_available",
      "module_id": "mainline_dispatch",
      "description": "无可用停留点或达到容量上限时发出阻塞观测。",
      "trigger": {
        "type": "state_change",
        "state": "conveyor_loads[*].current_load >= conveyor_loads[*].max_capacity"
      },
      "guard": {
        "all": [
          "no available stop point or current_load >= max_capacity"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.blocked",
        "payload": {
          "conveyor_id": "state.conveyor_id",
          "reason": "capacity_or_downstream_blocked"
        }
      }
    },
    {
      "rule_id": "emit_capacity_available_when_stop_point_released",
      "module_id": "mainline_dispatch",
      "description": "停留点释放且负载低于恢复阈值时发出容量恢复事件。",
      "trigger": {
        "type": "event",
        "event_id": "conveyor.stop_point_released"
      },
      "guard": {
        "all": [
          "conveyor_loads[trigger.payload.conveyor_id].current_load <= conveyor_loads[trigger.payload.conveyor_id].resume_threshold"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "conveyor.capacity_available",
        "payload": {
          "conveyor_id": "trigger.payload.conveyor_id"
        }
      }
    },
    {
      "rule_id": "produce_next_pallet",
      "module_id": "pallet_feed",
      "description": "托盘来源按节拍生成新托盘。",
      "trigger": {
        "type": "event",
        "event_id": "runtime.sim_start"
      },
      "guard": {
        "all": [
          "pallet_queue.not_empty",
          "not all robot stations busy"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "deterministic_priority",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "pallet_source_1",
        "behavior_id": "produce_material",
        "payload": {
          "material_id": "next pallet"
        }
      }
    },
    {
      "rule_id": "move_pallet_to_farthest_idle_station",
      "module_id": "mainline_dispatch",
      "description": "主线优先把新托盘送到最远端空闲机械臂工位。",
      "trigger": {
        "type": "event",
        "event_id": "pallet_source.material_ready"
      },
      "guard": {
        "all": [
          "main_conveyor_1 has available stop point",
          "at least one robot idle"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "deterministic_priority",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "main_conveyor_1",
        "behavior_id": "transport_to_exit",
        "payload": {
          "target_station_order": [
            "robot_3",
            "robot_2",
            "robot_1"
          ]
        }
      }
    },
    {
      "rule_id": "assigned_robot_sorts_pallet",
      "module_id": "mainline_dispatch",
      "description": "已分配机械臂处理对应工位托盘。",
      "trigger": {
        "type": "event",
        "event_id": "main_conveyor_1.station_candidate_ready"
      },
      "guard": {
        "all": [
          "assigned robot idle",
          "assigned output conveyor not blocked"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "robot_resource_claim",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "start_behavior",
        "instance_id": "policy.robot_id",
        "behavior_id": "pick_and_place",
        "payload": {
          "pallet_id": "trigger.payload.material_id",
          "target_conveyor_id": "policy.output_conveyor_id"
        }
      }
    },
    {
      "rule_id": "pause_mainline_when_all_robots_busy",
      "module_id": "pallet_feed",
      "description": "三台机械臂全忙时暂停主线和出料口。",
      "trigger": {
        "type": "state_change",
        "state": "all robot states == busy"
      },
      "guard": {
        "all": [
          "all robot stations busy"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "backpressure",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "mainline.pause_feed",
        "payload": {
          "reason": "all_robots_busy"
        }
      }
    },
    {
      "rule_id": "observe_continuous_to_discrete_boundary",
      "module_id": "mainline_dispatch",
      "description": "将连续输送、旋转或加工状态越过阈值转换为离散完成事件。",
      "trigger": {
        "type": "state_change",
        "state": "continuous_progress >= threshold"
      },
      "guard": {
        "all": [
          "active action progress reached boundary"
        ],
        "any": [],
        "none": []
      },
      "policy": {
        "policy_id": "deterministic_priority",
        "inputs": {},
        "bind_outputs_to": {}
      },
      "action": {
        "type": "emit_event",
        "event_id": "global.pallet_batch_sorted",
        "payload": {
          "reason": "threshold_reached"
        }
      }
    }
  ],
  "state_transition_rules": [
    {
      "rule_id": "mark_behavior_started",
      "trigger": {
        "type": "behavior_started",
        "behavior_ref": "*.transport_or_pick_behavior"
      },
      "effects": [
        "set device_states[instance_id] = busy_or_moving",
        "register active_actions[action_id]",
        "lock required resource_locks"
      ]
    },
    {
      "rule_id": "mark_behavior_completed",
      "trigger": {
        "type": "behavior_completed",
        "behavior_ref": "*.transport_or_pick_behavior"
      },
      "effects": [
        "set device_states[instance_id] = idle",
        "remove active_actions[action_id]",
        "release resource_locks owned by action"
      ]
    },
    {
      "rule_id": "behavior_failure_emits_observation",
      "trigger": {
        "type": "behavior_failed",
        "behavior_ref": "*.transport_or_pick_behavior"
      },
      "effects": [
        "set device_states[instance_id] = error",
        "emit observation.deadlock_detected or observation.invalid_requirement"
      ]
    },
    {
      "rule_id": "conveyor_accept_updates_occupancy",
      "trigger": {
        "type": "behavior_completed",
        "behavior_ref": "*.accept_material"
      },
      "effects": [
        "set conveyor_occupancy[conveyor_id][selected_stop_point] = material_id",
        "increment conveyor_loads[conveyor_id].current_load",
        "emit conveyor.stop_point_occupied"
      ]
    },
    {
      "rule_id": "conveyor_advance_updates_occupancy",
      "trigger": {
        "type": "behavior_completed",
        "behavior_ref": "*.advance_to_next_stop_point"
      },
      "effects": [
        "clear conveyor_occupancy[conveyor_id][from_point_id]",
        "set conveyor_occupancy[conveyor_id][to_point_id] = material_id",
        "emit conveyor.stop_point_released",
        "emit conveyor.stop_point_occupied"
      ]
    },
    {
      "rule_id": "conveyor_release_updates_load",
      "trigger": {
        "type": "behavior_completed",
        "behavior_ref": "*.release_material"
      },
      "effects": [
        "clear exit stop point occupancy",
        "decrement conveyor_loads[conveyor_id].current_load",
        "emit conveyor.stop_point_released"
      ]
    }
  ],
  "policies": {
    "deterministic_priority": {
      "type": "deterministic_priority",
      "params": {
        "tie_breaker": "rule_id_then_instance_id"
      }
    },
    "resource_lock": {
      "type": "resource_lock",
      "params": {
        "lock_scope": "instance_resource",
        "on_conflict": "wait"
      }
    },
    "deadlock_detection": {
      "type": "deadlock_detection",
      "params": {
        "condition": "no_enabled_behavior and completion_conditions_not_met",
        "emit": "observation.deadlock_detected"
      }
    },
    "conveyor_queue_wait": {
      "type": "queue_wait",
      "params": {
        "queue_scope": "conveyor_stop_points",
        "wait_when": "next_stop_point_occupied or downstream_unavailable",
        "resume_when": "stop_point_released or downstream_available"
      }
    },
    "conveyor_stop_point_selection": {
      "type": "nearest_available_stop_point",
      "params": {
        "search_direction": "towards_exit",
        "fallback": "wait_at_nearest_upstream_stop_point"
      }
    },
    "backpressure": {
      "type": "capacity_threshold",
      "params": {
        "blocked_when": "current_load >= max_capacity",
        "resume_when": "current_load <= resume_threshold",
        "pause_strategy": "pause_before_next_pick"
      }
    },
    "downstream_release": {
      "type": "downstream_release",
      "params": {
        "release_when": "downstream_entry_available and exit_stop_point_occupied",
        "on_blocked": "queue_wait"
      }
    },
    "robot_resource_claim": {
      "type": "shared_pool_claim",
      "params": {
        "mutual_exclusion": true,
        "claim_order": "deterministic_by_material_id",
        "eligible_when": "device_state == idle"
      }
    },
    "target_conveyor_selection": {
      "type": "load_balancing",
      "params": {
        "candidates": [
          "main_conveyor_1",
          "robot_1_out_conveyor",
          "robot_2_out_conveyor",
          "robot_3_out_conveyor"
        ],
        "prefer": "lowest_current_load_not_blocked"
      }
    }
  },
  "completion_conditions": [
    "pallet_queue.empty == true",
    "all assigned pallet workpiece pools empty",
    "active_actions.empty == true",
    "all conveyor_occupancy stop points are empty"
  ],
  "failure_observations": [
    {
      "observation_id": "deadlock_detected",
      "condition": "no_enabled_behavior and completion_conditions_not_met",
      "emit_event": "observation.deadlock_detected"
    },
    {
      "observation_id": "resource_conflict",
      "condition": "resource lock conflict exceeds retry threshold",
      "emit_event": "observation.deadlock_detected"
    },
    {
      "observation_id": "invalid_requirement",
      "condition": "goal references missing device, unsupported behavior, or impossible connection",
      "emit_event": "observation.invalid_requirement"
    }
  ]
}
