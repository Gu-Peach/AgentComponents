{
  "schema_id": "conveyor_1",
  "schema_type": "DeviceSpec",
  "version": "0.2.0",
  "name": "传送带 1",
  "description": "连续输送设备，负责将物料或物料载具从 entry 输送到 exit。",
  "source": {
    "kind": "image_inferred",
    "path": "docs/business/SimulationSchema/1.DeviceSpec/conveyor/conveyor_1.json"
  },
  "created_for": "图 1 / 图 4 / 图 7 中传送带设备本体建模",
  "references": [
    "schema.json",
    "../../../test/1.png",
    "../../../test/4.png",
    "../../../test/7.png"
  ],
  "notes": [
    "传送带通过 part_ready 通知下游设备物料到达出口。",
    "该设备本体默认支持基于 entry/exit 坐标线性插值生成停留点。"
  ],
  "device_spec_id": "conveyor_1",
  "device_type": "conveyor",
  "display_name": "传送带 1",
  "asset": {
    "model_format": "glb",
    "model_key": "assets/models/conveyor/conveyor.glb"
  },
  "params_schema": {
    "speed_mps": {
      "type": "number",
      "default": 0.4,
      "min": 0.05,
      "max": 2,
      "unit": "m/s"
    },
    "capacity": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 20
    },
    "resume_threshold": {
      "type": "integer",
      "default": 2,
      "min": 0,
      "max": 20
    },
    "stop_point_count": {
      "type": "integer",
      "default": 4,
      "min": 2,
      "max": 20
    }
  },
  "physical_interfaces": [
    {
      "interface_id": "entry",
      "kind": "material",
      "direction": "input",
      "node_name": "EntryAnchor",
      "material_classes": [
        "workpiece",
        "workpiece_carrier"
      ],
      "local_position": [
        -0.8,
        0,
        0.45
      ],
      "local_forward": [
        -1,
        0,
        0
      ],
      "local_frame": {
        "position": [
          -0.8,
          0,
          0.45
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          -1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": 0.02,
        "angle_deg": 3
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece",
          "match_rule": "intersects"
        }
      ]
    },
    {
      "interface_id": "exit",
      "kind": "material",
      "direction": "output",
      "node_name": "ExitAnchor",
      "material_classes": [
        "workpiece",
        "workpiece_carrier"
      ],
      "local_position": [
        0.8,
        0,
        0.45
      ],
      "local_forward": [
        1,
        0,
        0
      ],
      "local_frame": {
        "position": [
          0.8,
          0,
          0.45
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": 0.02,
        "angle_deg": 3
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece",
          "match_rule": "intersects"
        }
      ]
    }
  ],
  "process_ports": [
    {
      "port_id": "flow_input",
      "direction": "input",
      "label": "Input",
      "role": "flow_input",
      "bound_physical_interface": "entry",
      "local_frame": {
        "position": [
          -0.8,
          0,
          0.45
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          -1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "capacity_available",
        "stop_point_occupied"
      ]
    },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Output",
      "role": "flow_output",
      "bound_physical_interface": "exit",
      "local_frame": {
        "position": [
          0.8,
          0,
          0.45
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "part_ready",
        "blocked",
        "done",
        "stop_point_released",
        "release_waiting_material"
      ]
    }
  ],
  "signal_ports": [
    {
      "port_id": "part_ready",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "物料已到达输出工艺口，可触发下游释放或抓取。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "blocked",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "下游或内部容量阻塞状态。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "capacity_available",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "设备重新具备接收容量。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "stop_point_occupied",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "停留点被占用事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "stop_point_released",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "停留点释放事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "release_waiting_material",
      "direction": "input",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "释放等待物料的输入命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    }
  ],
  "interface_bindings": [
    {
      "process_port": "flow_input",
      "physical_interface": "entry",
      "binding_id": "bind_flow_input_entry",
      "binding_role": "entry",
      "signal_ports": [
        "capacity_available",
        "stop_point_occupied"
      ],
      "transport_behaviors": [
        "accept_material",
        "advance_to_next_stop_point",
        "transport_to_exit"
      ]
    },
    {
      "process_port": "flow_output",
      "physical_interface": "exit",
      "binding_id": "bind_flow_output_exit",
      "binding_role": "exit",
      "signal_ports": [
        "part_ready",
        "blocked",
        "done",
        "stop_point_released",
        "release_waiting_material"
      ],
      "transport_behaviors": [
        "advance_to_next_stop_point",
        "transport_to_exit",
        "release_material"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "accept_material",
      "behavior_type": "material_transfer",
      "input_process_port": "flow_input",
      "output_signals": [
        "stop_point_occupied"
      ],
      "preconditions": [
        "capacity_available == true",
        "entry_stop_point_available == true"
      ]
    },
    {
      "behavior_id": "advance_to_next_stop_point",
      "behavior_type": "stop_point_buffered_transport",
      "input_process_port": "flow_input",
      "output_process_port": "flow_output",
      "default_algorithm": "linear_stop_point_motion",
      "output_signals": [
        "stop_point_occupied",
        "stop_point_released"
      ]
    },
    {
      "behavior_id": "transport_to_exit",
      "behavior_type": "stop_point_buffered_transport",
      "input_process_port": "flow_input",
      "output_process_port": "flow_output",
      "default_algorithm": "linear_stop_point_motion",
      "output_signals": [
        "part_ready",
        "done",
        "stop_point_released"
      ]
    },
    {
      "behavior_id": "release_material",
      "behavior_type": "handoff",
      "input_signals": [
        "release_waiting_material"
      ],
      "output_process_port": "flow_output"
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "moving",
      "waiting_downstream",
      "blocked",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "belt_surface",
        "exclusive": false
      }
    ],
    "capacity": {
      "max_active_materials": 3,
      "queue_id": "stop_point_queue",
      "resume_threshold": 2
    },
    "error_policy": {
      "on_downstream_timeout": "emit_observation"
    }
  },
  "type_specific_contract": {
    "conveyor_geometry": {
      "length_m": 1.6,
      "width_m": 0.35,
      "height_m": 0.45
    },
    "motion_model": {
      "type": "linear",
      "axis": [
        1,
        0,
        0
      ],
      "speed_param": "speed_mps"
    },
    "stop_point_model": {
      "type": "linear_interpolation",
      "start_interface": "entry",
      "end_interface": "exit",
      "default_stop_point_count": 4,
      "include_entry": true,
      "include_exit": true,
      "coordinate_formula": "entry + t * (exit - entry)",
      "spacing_policy": "evenly_spaced"
    },
    "queue_policy": {
      "when_downstream_busy": "wait_at_nearest_upstream_stop_point",
      "release_on_signal": "release_waiting_material"
    }
  }
}
