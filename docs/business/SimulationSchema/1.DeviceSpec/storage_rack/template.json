{
  "schema_id": "storage_rack_template_required",
  "schema_type": "DeviceSpecTemplate",
  "version": "0.1.0",
  "name": "存储柜 / 货架设备本体填写模板",
  "description": "用于新增存储柜或货架 DeviceSpec。",
  "source": {
    "kind": "manual_template",
    "path": "docs/business/SimulationSchema/1.DeviceSpec/storage_rack/template.json"
  },
  "created_for": "storage_rack 设备本体建模",
  "references": [
    "../common_device_spec.schema.json",
    "schema.json",
    "storage_rack_1.json"
  ],
  "notes": [
    "当前模板适用于静态存储资源；自动出入库可后续扩展 storage_system。"
  ],
  "device_spec_id": "storage_rack_id_required",
  "device_type": "storage_rack",
  "display_name": "存储柜展示名_required",
  "asset": {
    "model_format": "glb_optional",
    "model_key": "assets/models/storage/{file}.glb_optional"
  },
  "params_schema": {
    "rows": { "type": "integer", "default": "行数_required" },
    "columns": { "type": "integer", "default": "列数_required" }
  },
  "physical_interfaces": [
    {
      "interface_id": "cell_input",
      "kind": "material",
      "direction": "input",
      "node_name": "CellInput_required",
      "material_classes": ["workpiece_required"]
    },
    {
      "interface_id": "cell_output",
      "kind": "material",
      "direction": "output",
      "node_name": "CellOutput_required",
      "material_classes": ["workpiece_required"]
    }
  ],
  "process_ports": [
    { "port_id": "flow_input", "direction": "input", "label": "Store Input" },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Release Output"
    }
  ],
  "signal_ports": [
    {
      "port_id": "cell_available",
      "direction": "output",
      "value_type": "event"
    },
    { "port_id": "cell_full", "direction": "output", "value_type": "boolean" },
    { "port_id": "stored", "direction": "output", "value_type": "event" },
    { "port_id": "released", "direction": "output", "value_type": "event" }
  ],
  "interface_bindings": [
    { "process_port": "flow_input", "physical_interface": "cell_input" },
    { "process_port": "flow_output", "physical_interface": "cell_output" }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "reserve_cell",
      "behavior_type": "storage_reservation",
      "output_signals": ["cell_available"]
    },
    {
      "behavior_id": "store_to_cell",
      "behavior_type": "storage",
      "input_physical_interface": "cell_input",
      "output_signals": ["stored", "cell_full"]
    },
    {
      "behavior_id": "release_from_cell",
      "behavior_type": "storage_release",
      "output_physical_interface": "cell_output",
      "output_signals": ["released"]
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "reserving",
      "storing",
      "releasing",
      "full",
      "error"
    ],
    "default_state": "idle",
    "resources": [{ "resource_id": "storage_cells", "exclusive": false }],
    "capacity": { "max_active_materials": "rows*columns_required" }
  },
  "type_specific_contract": {
    "cells": {
      "rows": "行数_required",
      "columns": "列数_required",
      "cell_ids": ["库位ID_required"]
    },
    "capacity": {
      "total_cells": "总库位数_required",
      "material_classes": ["workpiece_required"]
    },
    "reservation_policy": {
      "strategy": "first_available|nearest|required",
      "release_on": "released"
    }
  }
}
