{
  "schema_id": "storage_rack_device_spec_schema_v0_2",
  "schema_type": "DeviceTypeSchema",
  "version": "0.2.0",
  "name": "Storage Rack DeviceSpec 规范",
  "description": "存储柜/货架设备本体规范，表达库位、容量、入库和出库接口。",
  "source": { "kind": "manual_design", "path": "docs/business/SimulationSchema/1.DeviceSpec/storage_rack/schema.json" },
  "created_for": "图 7 中存储柜/货架建模",
  "references": ["../common_device_spec.schema.json", "../schema.json", "storage_rack_1.json"],
  "notes": [
    "当前先作为静态存储设备建模，自动出入库可后续扩展 storage_system。",
    "v0.2 要求 cell 既可作为工艺库位端口，也可绑定 cell_available/cell_full/stored/released 信号。"
  ],
  "extends": "common_device_spec_schema_v0_2",
  "required_type_specific_fields": ["cells", "capacity", "reservation_policy"],
  "required_behaviors": ["store_to_cell", "release_from_cell", "reserve_cell"],
  "required_signals": ["cell_available", "cell_full", "stored", "released"],
  "vc_aligned_port_requirements": {
    "physical_interfaces": {
      "required_interface_pattern": "cell_* or rack_access_*",
      "required_fields": ["interface_id", "kind", "direction", "local_frame"],
      "recommended_fields": ["material_classes", "snap_tolerance", "compatibility_fields"]
    },
    "process_ports": {
      "required_port_patterns": ["flow_input", "flow_output", "cell_*"],
      "required_fields": ["port_id", "direction", "role"],
      "recommended_fields": ["local_frame", "accepted_material_types", "capacity", "bound_signal_ports"],
      "port_roles": { "flow_input": "material_entry", "flow_output": "material_exit", "cell_*": "storage_cell" }
    },
    "signal_ports": {
      "required_fields": ["port_id", "direction", "value_type", "edge_trigger", "retention"],
      "required_semantics": {
        "cell_available": "库位可用状态或事件，payload 应包含 cell_id。",
        "cell_full": "库位满载状态，payload 应包含 cell_id。",
        "stored": "入库完成事件。",
        "released": "出库完成事件。"
      }
    },
    "interface_bindings": {
      "required_fields": ["binding_id", "physical_interface", "process_port", "signal_ports", "transport_behaviors"],
      "required_binding_pattern": "cell process_port 绑定对应 physical_interface，并绑定 cell_available/cell_full/stored/released 信号。"
    }
  }
}
