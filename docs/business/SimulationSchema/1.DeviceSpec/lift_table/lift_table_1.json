      "bound_to": {
        "type": "physical_interface",
        "id": "platform"
      }
    },
    {
      "port_id": "moving",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "平台正在移动状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "platform"
      }
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "设备异常事件。",
      "bound_to": {
        "type": "physical_interface",
        "id": "platform"
      }
    }
