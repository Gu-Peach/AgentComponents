      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      },
      "payload_schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          }
        }
      }
    },
    {
      "port_id": "at_level",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
