        "level_id": "lower",
        "height_m": 0.3
      },
      {
        "level_id": "upper",
        "height_m": 1.8
      }
    ],
    "lift_motion": {
      "axis": [
        0,
        1,
        0
      ],
      "speed_param": "lift_speed_mps"
    },
    "dock_policy": {
      "requires_level_match": true,
      "tolerance_m": 0.02
    }
  }
