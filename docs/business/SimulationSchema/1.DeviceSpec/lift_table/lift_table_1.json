      "physical_interface": "upper_dock",
      "binding_id": "bind_flow_output_upper_dock",
      "binding_role": "exit",
      "signal_ports": [
        "done"
      ],
      "transport_behaviors": [
        "lift_to_level",
        "release_material"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "accept_material",
      "behavior_type": "material_handoff",
      "input_physical_interface": "lower_dock",
      "output_physical_interface": "platform"
    },
    {
      "behavior_id": "lift_to_level",
      "behavior_type": "vertical_motion",
      "input_signals": [
        "move_to_level"
      ],
      "output_signals": [
        "moving",
        "at_level",
        "done"
      ]
    },
    {
      "behavior_id": "release_material",
      "behavior_type": "material_handoff",
      "input_physical_interface": "platform",
      "output_physical_interface": "upper_dock"
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "loading",
      "moving",
      "at_lower",
      "at_upper",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "lift_platform",
        "exclusive": true
      }
    ],
    "capacity": {
