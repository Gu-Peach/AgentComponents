        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": "distance_m_optional",
        "angle_deg": "angle_deg_optional"
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece_carrier",
          "match_rule": "intersects"
