        "workpiece"
      ],
      "local_frame": {
        "position": [
          "x_bottom_optional",
          "y_bottom_optional",
          "z_bottom_optional"
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          "fx_optional",
          "fy_optional",
          "fz_optional"
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": "distance_m_optional",
        "angle_deg": "angle_deg_optional"
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece",
          "match_rule": "intersects"
        }
      ]
    }
