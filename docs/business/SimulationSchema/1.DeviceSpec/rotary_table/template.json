{
  "schema_id": "rotary_table_template_required",
  "schema_type": "DeviceSpecTemplate",
  "version": "0.2.0",
  "name": "旋转台设备本体填写模板",
  "description": "用于新增多工位旋转台 DeviceSpec。",
  "source": {
    "kind": "manual_template",
    "path": "docs/business/SimulationSchema/1.DeviceSpec/rotary_table/template.json"
  },
  "created_for": "rotary_table 设备本体建模",
  "references": [
    "../common_device_spec.schema.json",
    "schema.json",
    "rotary_table_1.json"
  ],
  "notes": [
    "旋转台默认按离散工位 indexing 建模。"
  ],
  "device_spec_id": "rotary_table_id_required",
  "device_type": "rotary_table",
  "display_name": "旋转台展示名_required",
  "asset": {
    "model_format": "glb_optional",
    "model_key": "assets/models/rotary/{file}.glb_optional"
  },
  "params_schema": {
    "rotate_speed_deg_s": {
      "type": "number",
      "default": "旋转速度_required",
      "unit": "deg/s"
    },
    "station_count": {
      "type": "integer",
      "default": "工位数_required"
    }
  },
  "physical_interfaces": [
    {
      "interface_id": "station_a",
      "kind": "material",
      "direction": "bidirectional",
      "node_name": "StationA_required",
      "material_classes": [
        "workpiece_required"
      ],
      "local_frame": {
        "position": [
          "x_station_a_optional",
          "y_station_a_optional",
          "z_station_a_optional"
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          "fx_optional",
          "fy_optional",
          "fz_optional"
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": "distance_m_optional",
        "angle_deg": "angle_deg_optional"
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece_required",
          "match_rule": "intersects"
        }
      ]
    },
    {
      "interface_id": "station_b",
      "kind": "material",
      "direction": "bidirectional",
      "node_name": "StationB_required",
      "material_classes": [
        "workpiece_required"
      ],
      "local_frame": {
        "position": [
          "x_station_b_optional",
          "y_station_b_optional",
          "z_station_b_optional"
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          "fx_optional",
          "fy_optional",
          "fz_optional"
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": "distance_m_optional",
        "angle_deg": "angle_deg_optional"
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece_required",
          "match_rule": "intersects"
        }
      ]
    }
  ],
  "process_ports": [
    {
      "port_id": "flow_input",
      "direction": "input",
      "label": "Rotary Input",
      "role": "flow_input",
      "bound_physical_interface": "station_a",
      "local_frame": {
        "position": [
          "x_station_a_optional",
          "y_station_a_optional",
          "z_station_a_optional"
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          "fx_optional",
          "fy_optional",
          "fz_optional"
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece_required"
      ],
      "bound_signal_ports": [
        "rotate_to_station"
      ]
    },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Rotary Output",
      "role": "flow_output",
      "bound_physical_interface": "station_b",
      "local_frame": {
        "position": [
          "x_station_b_optional",
          "y_station_b_optional",
          "z_station_b_optional"
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          "fx_optional",
          "fy_optional",
          "fz_optional"
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece_required"
      ],
      "bound_signal_ports": [
        "at_station",
        "done"
      ]
    }
  ],
  "signal_ports": [
    {
      "port_id": "rotate_to_station",
      "direction": "input",
      "value_type": "command",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "命令转台旋转到目标工位。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      },
      "payload_schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          }
        }
      }
    },
    {
      "port_id": "at_station",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "转台到位事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "occupied",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "当前工位占用状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "station_a"
      }
    },
    {
      "port_id": "rotating",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "转台正在旋转状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "station_a"
      }
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    }
  ],
  "interface_bindings": [
    {
      "process_port": "flow_input",
      "physical_interface": "station_a",
      "binding_id": "bind_flow_input_station_a",
      "binding_role": "entry",
      "signal_ports": [
        "rotate_to_station",
        "occupied",
        "rotating"
      ],
      "transport_behaviors": [
        "accept_material",
        "rotate_to_station",
        "release_material"
      ]
    },
    {
      "process_port": "flow_output",
      "physical_interface": "station_b",
      "binding_id": "bind_flow_output_station_b",
      "binding_role": "exit",
      "signal_ports": [
        "at_station",
        "done"
      ],
      "transport_behaviors": [
        "rotate_to_station",
        "release_material"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "accept_material",
      "behavior_type": "material_handoff",
      "input_physical_interface": "station_a",
      "output_signals": [
        "occupied"
      ]
    },
    {
      "behavior_id": "rotate_to_station",
      "behavior_type": "rotary_motion",
      "input_signals": [
        "rotate_to_station"
      ],
      "output_signals": [
        "rotating",
        "at_station",
        "done"
      ]
    },
    {
      "behavior_id": "release_material",
      "behavior_type": "material_handoff",
      "output_physical_interface": "station_b",
      "output_signals": [
        "occupied"
      ]
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "occupied",
      "rotating",
      "at_station",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "rotary_plate",
        "exclusive": true
      }
    ],
    "capacity": {
      "max_active_materials": "工位容量_required"
    }
  },
  "type_specific_contract": {
    "stations": [
      {
        "station_id": "station_a_required",
        "angle_deg": "角度_required"
      },
      {
        "station_id": "station_b_required",
        "angle_deg": "角度_required"
      }
    ],
    "rotation_axis": [
      0,
      1,
      0
    ],
    "indexing_policy": {
      "mode": "discrete",
      "speed_param": "rotate_speed_deg_s",
      "tolerance_deg": "角度容差_optional"
    }
  }
}
