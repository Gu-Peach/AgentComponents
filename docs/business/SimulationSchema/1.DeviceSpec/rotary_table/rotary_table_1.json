      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "rotate_to_station"
      ]
    },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Rotary Output",
      "role": "flow_output",
      "bound_physical_interface": "station_b",
      "local_frame": {
        "position": [
          0.35,
          0,
          0.6
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
