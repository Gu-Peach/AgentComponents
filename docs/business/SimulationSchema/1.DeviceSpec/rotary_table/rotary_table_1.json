          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "snap_tolerance": {
        "distance_m": 0.02,
        "angle_deg": 3
      },
      "compatibility_fields": [
        {
          "field_id": "material_class",
          "type": "material_class",
          "name": "Material class",
          "value": "workpiece",
          "match_rule": "intersects"
