        "properties": {
          "target": {
            "type": "string"
          }
        }
      }
    },
    {
      "port_id": "at_station",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "转台到位事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "occupied",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "当前工位占用状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "station_a"
      }
    },
    {
      "port_id": "rotating",
      "direction": "output",
      "value_type": "boolean",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "转台正在旋转状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "station_a"
      }
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    }
  ],
  "interface_bindings": [
    {
      "process_port": "flow_input",
      "physical_interface": "station_a",
      "binding_id": "bind_flow_input_station_a",
      "binding_role": "entry",
      "signal_ports": [
        "rotate_to_station",
        "occupied",
        "rotating"
      ],
      "transport_behaviors": [
        "accept_material",
        "rotate_to_station",
        "release_material"
      ]
    },
    {
      "process_port": "flow_output",
      "physical_interface": "station_b",
      "binding_id": "bind_flow_output_station_b",
      "binding_role": "exit",
      "signal_ports": [
        "at_station",
        "done"
      ],
      "transport_behaviors": [
        "rotate_to_station",
        "release_material"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "accept_material",
      "behavior_type": "material_handoff",
      "input_physical_interface": "station_a",
      "output_signals": [
        "occupied"
      ]
    },
    {
      "behavior_id": "rotate_to_station",
      "behavior_type": "rotary_motion",
      "input_signals": [
        "rotate_to_station"
      ],
      "output_signals": [
        "rotating",
        "at_station",
        "done"
      ]
    },
    {
      "behavior_id": "release_material",
      "behavior_type": "material_handoff",
      "output_physical_interface": "station_b",
      "output_signals": [
        "occupied"
      ]
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "occupied",
      "rotating",
      "at_station",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "rotary_plate",
        "exclusive": true
      }
    ],
    "capacity": {
      "max_active_materials": 2
    }
  },
  "type_specific_contract": {
    "stations": [
      {
        "station_id": "station_a",
        "angle_deg": 180
      },
      {
        "station_id": "station_b",
        "angle_deg": 0
      }
    ],
    "rotation_axis": [
      0,
      1,
      0
    ],
    "indexing_policy": {
      "mode": "discrete",
      "speed_param": "rotate_speed_deg_s",
      "tolerance_deg": 1
    }
  }
