{
  "schema_id": "signal_bus_schema_example_figure_1_v0_1",
  "schema_type": "SignalBusSchema",
  "version": "0.1.0",
  "name": "Figure 1 SignalBusSchema Example",
  "description": "传送带 part_ready 触发机械臂 start_pick 的信号示例。",
  "source": {
    "kind": "compiled_example",
    "compiled_from": [
      "../2.SceneDocument/example.json",
      "../5.SimPlan/example.json"
    ]
  },
  "created_for": "信号通讯示例",
  "references": [
    "../1.DeviceSpec/conveyor/conveyor_1.json",
    "../1.DeviceSpec/robot_arm/robot_arm_1.json"
  ],
  "notes": ["普通信号流转不调用 LLM。"],
  "routes": [
    {
      "route_id": "route_001",
      "source_signal": "conveyor_1.part_ready",
      "target_signal": "robot_1.start_pick",
      "payload_schema": "payload_material_event",
      "delivery": "at_least_once"
    }
  ],
  "wait_rules": [
    {
      "rule_id": "wait_001",
      "condition": "robot_1.busy == true",
      "waiting_location": "conveyor_1.exit",
      "queue_id": "conveyor_1.exit_queue",
      "release_on": "robot_1.done"
    }
  ],
  "payload_schemas": {
    "payload_material_event": {
      "material_id": "string",
      "source_instance_id": "string",
      "timestamp": "number"
    }
  },
  "timeout_rules": [
    {
      "rule_id": "timeout_001",
      "target": "robot_1.start_pick",
      "timeout_s": 30,
      "on_timeout": "emit_observation"
    }
  ]
}
