{
  "schema_id": "sim_plan_example_figure_1_v0_1",
  "schema_type": "SimPlan",
  "version": "0.1.0",
  "name": "Figure 1 SimPlan Example",
  "description": "将物料从传送带交给机械臂的初版计划。",
  "source": { "kind": "agent_example", "agent_run_id": "agent_run_example_001" },
  "created_for": "Agent 计划示例",
  "references": ["../2.SceneDocument/example.json", "../3.SceneTransportSchema/example.json"],
  "notes": ["该计划仅展示结构，不代表完整调度算法。"],
  "goal": "move part_001 from conveyor_1.exit to robot_1.pick_area",
  "process_route": ["conveyor_1", "robot_1"],
  "selected_devices": ["conveyor_1", "robot_1"],
  "transport_steps": [
    { "step_id": "step_001", "instance_id": "conveyor_1", "behavior_id": "transport_to_exit", "outputs": ["conveyor_1.part_ready"] },
    { "step_id": "step_002", "instance_id": "robot_1", "behavior_id": "pick_and_place", "depends_on": ["step_001"], "trigger": "conveyor_1.part_ready", "outputs": ["robot_1.busy", "robot_1.done"] }
  ],
  "signal_rules": [
    { "rule_id": "sig_rule_001", "source": "conveyor_1.part_ready", "target": "robot_1.start_pick" }
  ],
  "success_criteria": ["material_at(part_001, robot_1.pick_area)", "robot_1.done == true"],
  "interrupt_policy": { "on_user_interrupt": "pause_and_replan_remaining", "on_deadlock": "emit_observation" }
}

