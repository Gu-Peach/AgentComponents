          }
        }
      ],
      "routes": [
        {
          "from": "runtime.sim_start",
          "to": "main_conveyor_1.start_transport",
          "delivery": "direct"
        },
        {
          "from": "main_conveyor_1.pallet_ready",
          "to": "parallel_robot_sorting.enable",
          "delivery": "broadcast"
        },
        {
          "from": "robot.pick_request",
          "to": "policies.claim_workpiece",
          "delivery": "runtime_internal"
        },
        {
          "from": "global.workpiece_claimed",
          "to": "robot.start_pick",
          "delivery": "targeted_by_payload.robot_id"
        },
        {
          "from": "robot.pick_done",
          "to": "output_conveyor.material_arrived",
          "delivery": "targeted_by_payload.target_conveyor"
        },
        {
          "from": "output_conveyor.blocked",
          "to": "robot.pause_pick",
          "delivery": "targeted_by_backpressure_binding"
        },
        {
          "from": "output_conveyor.capacity_available",
          "to": "robot.resume_pick",
          "delivery": "targeted_by_backpressure_binding"
        },
        {
          "from": "global.sorting_done",
          "to": "runtime.complete_run",
          "delivery": "runtime_internal"
        }
      ],
      "backpressure_bindings": [
        {
          "conveyor_id": "upper_out_conveyor_1",
          "affected_robots": [
            "robot_1",
            "robot_2"
          ]
        },
        {
          "conveyor_id": "lower_out_conveyor_1",
          "affected_robots": [
            "robot_1",
            "robot_2"
          ]
        }
      ]
    },
    "state_model": {
      "workpiece_pool": {
        "pallet_1.remaining_parts": {
          "initial_items": [
            "part_001",
            "part_002",
            "part_003",
            "part_004",
            "part_005",
            "part_006",
            "part_007",
            "part_008",
            "part_009",
            "part_010",
            "part_011",
            "part_012"
          ],
          "claimed": {},
          "completed": []
        }
      },
      "material_claims": {},
      "conveyor_loads": {
        "upper_out_conveyor_1": {
          "current_load": 0,
          "max_capacity": 5,
          "resume_threshold": 3,
          "blocked": false
        },
        "lower_out_conveyor_1": {
          "current_load": 0,
          "max_capacity": 5,
          "resume_threshold": 3,
          "blocked": false
        }
      },
      "device_states": {
        "main_conveyor_1": "idle",
        "robot_1": "idle",
        "robot_2": "idle",
        "upper_out_conveyor_1": "idle",
        "lower_out_conveyor_1": "idle"
      },
      "signal_values": {},
      "resource_locks": {
        "main_conveyor_1.belt_surface": null,
        "robot_1.robot_arm": null,
        "robot_1.gripper": null,
        "robot_2.robot_arm": null,
        "robot_2.gripper": null,
        "upper_out_conveyor_1.belt_surface": null,
        "lower_out_conveyor_1.belt_surface": null
      },
      "active_actions": {}
    },
    "behavior_rules": [
      {
        "rule_id": "start_pallet_transport",
        "module_id": "pallet_transport",
        "when_event": "runtime.sim_start",
        "if": [
          "device_states.main_conveyor_1 == idle",
          "material_at(pallet_1, main_conveyor_1.entry)"
        ],
        "then_start_behavior": {
          "instance_id": "main_conveyor_1",
          "behavior_id": "transport_to_exit",
          "payload": {
            "carrier_id": "pallet_1"
          }
        }
      },
      {
        "rule_id": "idle_robot_requests_workpiece",
        "module_id": "parallel_robot_sorting",
        "when_state": "robot.state == idle",
        "if": [
          "workpiece_pool.pallet_1.remaining_parts.empty == false",
          "target_conveyors.blocked_for_robot(robot.id) == false",
          "resource(robot.gripper).locked_by == null"
        ],
        "then_emit": {
          "event_id": "robot.pick_request",
          "payload": {
            "robot_id": "${robot.id}"
          }
        }
      },
      {
        "rule_id": "claimed_workpiece_starts_pick",
        "module_id": "parallel_robot_sorting",
        "when_event": "global.workpiece_claimed",
        "if": [
          "payload.robot_id.state == idle",
          "payload.material_id.claimed_by == payload.robot_id"
        ],
        "then_start_behavior": {
          "instance_id": "${payload.robot_id}",
          "behavior_id": "pick_and_place",
          "payload": {
            "material_id": "${payload.material_id}"
          }
        }
      },
      {
        "rule_id": "output_conveyor_runs_when_material_arrives",
        "module_id": "output_conveying",
        "when_event": "output_conveyor.material_arrived",
        "if": [
          "payload.conveyor_id.state in [idle, moving]",
          "conveyor_loads[payload.conveyor_id].current_load > 0"
        ],
        "then_start_or_continue_behavior": {
          "instance_id": "${payload.conveyor_id}",
          "behavior_id": "transport_to_exit"
        }
      },
      {
        "rule_id": "blocked_conveyor_pauses_robot",
        "module_id": "parallel_robot_sorting",
        "when_event": "output_conveyor.blocked",
        "then_emit": {
          "event_id": "robot.pause_pick",
          "target": "robots_bound_to_conveyor(payload.conveyor_id)",
          "payload": {
            "reason": "target_conveyor_blocked"
          }
        }
      },
      {
        "rule_id": "capacity_available_resumes_robot",
        "module_id": "parallel_robot_sorting",
        "when_event": "output_conveyor.capacity_available",
        "then_emit": {
          "event_id": "robot.resume_pick",
          "target": "robots_bound_to_conveyor(payload.conveyor_id)"
        }
      }
    ],
    "state_transition_rules": [
      {
        "rule_id": "pallet_transport_start",
        "on_behavior_start": "main_conveyor_1.transport_to_exit",
        "effects": [
          "set device_states.main_conveyor_1 = moving",
          "lock main_conveyor_1.belt_surface"
        ]
      },
      {
        "rule_id": "pallet_transport_complete",
        "on_behavior_complete": "main_conveyor_1.transport_to_exit",
        "effects": [
          "move pallet_1 to main_conveyor_1.exit",
          "set device_states.main_conveyor_1 = idle",
          "unlock main_conveyor_1.belt_surface",
          "emit main_conveyor_1.pallet_ready"
        ]
      },
      {
        "rule_id": "claim_workpiece",
        "on_event": "robot.pick_request",
        "effects": [
          "policies.claim_workpiece atomically removes next available material from workpiece_pool",
          "set material_claims[material_id] = robot_id",
          "emit global.workpiece_claimed"
        ]
      },
      {
        "rule_id": "robot_pick_start",
        "on_behavior_start": "*.pick_and_place",
        "effects": [
          "set device_states[robot_id] = busy",
          "lock robot_id.robot_arm",
          "lock robot_id.gripper"
        ]
      },
      {
        "rule_id": "robot_pick_complete",
        "on_behavior_complete": "*.pick_and_place",
        "effects": [
          "move material_id to target_conveyor.entry",
          "append material_id to workpiece_pool.completed",
          "set device_states[robot_id] = idle",
          "unlock robot_id.gripper",
          "unlock robot_id.robot_arm",
          "emit robot.pick_done"
        ]
      },
      {
        "rule_id": "output_material_arrival_updates_load",
        "on_event": "output_conveyor.material_arrived",
        "effects": [
          "increment conveyor_loads[conveyor_id].current_load",
          "if current_load >= max_capacity emit output_conveyor.blocked"
        ]
      },
      {
        "rule_id": "output_conveyor_transport_complete",
        "on_behavior_complete": "*.transport_to_exit where instance in [upper_out_conveyor_1, lower_out_conveyor_1]",
        "effects": [
          "decrement conveyor_loads[conveyor_id].current_load",
          "if blocked == true and current_load <= resume_threshold emit output_conveyor.capacity_available"
        ]
      },
      {
        "rule_id": "robot_pause",
        "on_event": "robot.pause_pick",
        "effects": [
          "set device_states[robot_id] = waiting_downstream after current safe action boundary"
        ]
      },
      {
        "rule_id": "robot_resume",
        "on_event": "robot.resume_pick",
        "effects": [
          "set device_states[robot_id] = idle if robot has no active action"
        ]
      }
    ],
    "policies": {
      "claim_workpiece": {
        "type": "shared_pool_claim",
        "source_pool": "workpiece_pool.pallet_1.remaining_parts",
        "workers": [
          "robot_1",
          "robot_2"
        ],
        "selection": "next_available_material",
        "mutual_exclusion": true,
        "on_empty": "emit global.workpiece_pool_empty"
      },
      "target_conveyor_selection": {
        "type": "load_balancing",
        "candidates": [
          "upper_out_conveyor_1",
          "lower_out_conveyor_1"
        ],
        "strategy": "choose_non_blocked_lower_load",
        "fallback": "wait_until_capacity_available"
      },
      "backpressure": {
        "type": "capacity_threshold",
        "blocked_when": "current_load >= max_capacity",
        "resume_when": "current_load <= resume_threshold",
        "pause_strategy": "pause_before_next_pick"
      }
    },
    "completion_conditions": [
      "workpiece_pool.pallet_1.remaining_parts.empty == true",
      "device_states.robot_1 in [idle, waiting_downstream]",
      "device_states.robot_2 in [idle, waiting_downstream]",
      "conveyor_loads.upper_out_conveyor_1.current_load == 0",
      "conveyor_loads.lower_out_conveyor_1.current_load == 0",
      "active_actions.empty == true"
    ],
    "failure_observations": [
      {
        "observation_id": "workpiece_claim_conflict",
        "condition": "same material_id claimed_by multiple robots",
        "severity": "error"
      },
      {
        "observation_id": "output_conveyor_over_capacity",
        "condition": "current_load > max_capacity",
        "severity": "error"
      },
      {
        "observation_id": "deadlock_detected",
        "condition": "workpiece_pool not empty and no enabled robot and no active output transport",
        "severity": "warning"
      },
      {
        "observation_id": "resource_lock_timeout",
        "condition": "resource lock held longer than timeout",
        "severity": "warning"
      }
    ]
  },
