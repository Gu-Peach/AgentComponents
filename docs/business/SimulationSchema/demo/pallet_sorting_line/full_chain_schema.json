  "scene_behavior_graph": {
    "schema_id": "scene_behavior_graph_pallet_sorting_line_v0_2",
    "schema_type": "SceneBehaviorGraph",
    "version": "0.2.0",
    "name": "Pallet Sorting Line SceneBehaviorGraph",
    "description": "Agent 基于设备能力、显式场景事实和用户目标生成的场景行为图：主传送带送托盘到位，两个机械臂共享工件池并行分拣，出料传送带通过 backpressure 控制机械臂节奏。",
    "source": {
      "kind": "agent_generated_behavior_model",
      "agent_run_id": "agent_run_pallet_sorting_line_002",
      "from": [
        "device_specs",
        "scene_document",
        "user_goal",
        "scene_validation_report"
      ]
    },
    "created_for": "作为 Simulation Runtime 的运行依据，替代旧拆分链路中的多个中间产物。",
    "references": [
      "scene_document_pallet_sorting_line_v0_1",
      "scene_behavior_graph_schema_contract_v0_2"
    ],
    "notes": [
      "不是固定批次分拣；两个机械臂从共享工件池动态 claim 物料。",
      "出料传送带持续运行并维护负载；超载时通过 blocked 事件产生 backpressure。",
      "机械臂收到 pause_pick 后不再启动下一次抓取；已在执行的安全动作默认完成后进入 waiting。"
    ],
    "goal": {
      "natural_language": "主传送带先将装有多个物料的托盘运到中央分拣位；两个机械臂持续从托盘上抓取物料并放到两条出料传送带；出料传送带持续运行，负载过高时暂停对应机械臂，负载降低后恢复，直到托盘物料全部分拣并输出。",
      "assumptions": [
        "当前只建模基线运行，不处理用户中途修改需求。",
        "两个机械臂可覆盖托盘取料区域，取料通过共享工件池互斥 claim。",
        "目标传送带可持续运行，负载阈值由 behavior graph 的 policy 定义。",
        "机械臂 pause 采用 pause_before_next_pick 策略，不强行中断已经抓取中的动作。"
      ]
    },
    "modules": [
      {
        "module_id": "pallet_transport",
        "name": "托盘运输模块",
        "mode": "one_shot",
        "devices": [
          "main_conveyor_1"
        ],
        "start_event": "runtime.sim_start",
        "complete_event": "main_conveyor_1.pallet_ready",
        "task": "将 pallet_1 从 main_conveyor_1.entry 输送到 main_conveyor_1.exit。"
      },
      {
        "module_id": "parallel_robot_sorting",
        "name": "并行机械臂分拣模块",
        "mode": "parallel_continuous",
        "devices": [
          "robot_1",
          "robot_2"
        ],
        "start_event": "main_conveyor_1.pallet_ready",
        "source_pool": "workpiece_pool.pallet_1.remaining_parts",
        "claim_policy": "first_idle_robot_claim_next_available_part",
        "stop_condition": "workpiece_pool.pallet_1.remaining_parts.empty == true and robot_1.state == idle and robot_2.state == idle"
      },
      {
        "module_id": "output_conveying",
        "name": "出料传送模块",
        "mode": "parallel_continuous",
        "devices": [
          "upper_out_conveyor_1",
          "lower_out_conveyor_1"
        ],
        "start_event": "first_material_arrived_at_output_conveyor",
        "stop_condition": "workpiece_pool.pallet_1.remaining_parts.empty == true and conveyor_loads.upper_out_conveyor_1.current_load == 0 and conveyor_loads.lower_out_conveyor_1.current_load == 0"
      }
    ],
    "event_bus": {
