# API
APP_NAME="VC Simulation Backend"
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
AUTO_CREATE_TABLES=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase local Postgres. Run from backend/: supabase start
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55422/postgres

# Supabase local API / Storage metadata
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_STORAGE_BUCKET_MODELS=models
SUPABASE_STORAGE_BUCKET_THUMBNAILS=thumbnails
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads
SUPABASE_STORAGE_BUCKET_EXPORTS=exports

# Redis local. Run from backend/: docker compose up -d redis
REDIS_URL=redis://:local_redis_pass@127.0.0.1:6380/0
RUNTIME_STATE_TTL_SECONDS=86400
