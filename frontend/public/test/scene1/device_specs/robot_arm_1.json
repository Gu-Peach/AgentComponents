            "z": 1
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        },
        {
          "name": "joint_5",
          "nodeName": "Link5_00Mn",
          "type": "revolute",
          "axis": {
            "x": 1,
            "y": 0,
            "z": 0
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        },
        {
          "name": "joint_6",
          "nodeName": "Link6_00Nn",
          "type": "revolute",
          "axis": {
            "x": 0,
            "y": 1,
            "z": 0
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        }
      ]
    },
    "trajectoryConfig": {
      "liftHeight": 0.3,
      "speed": 1
    },
    "workspace": {
      "shape": "cylinder",
      "radius_m": 1.2,
      "height_m": 1.5
    },
    "gripper": {
      "type": "vacuum_or_clamp",
      "supported_material_classes": [
        "workpiece",
        "workpiece_carrier"
      ],
      "max_payload_kg": 5
    }
  }
}
