        ],
        "up": [
          0,
          1,
          0
        ]
      },
      "snap_tolerance": {
        "distance_m": 0.02,
        "angle_deg": 3
      },
      "compatibility_fields": [
        {
          "field_id": "anchor_role",
          "type": "layout_anchor",
          "name": "Anchor role",
          "value": "robot_base_mount",
          "match_rule": "equals"
        }
      ]
    },
    {
      "interface_id": "bbox_bottom_back_right",
      "kind": "layout_mount_anchor",
      "direction": "none",
      "node_name": "BboxBottomBackRight",
      "local_frame": {
        "position": [
          0.4,
