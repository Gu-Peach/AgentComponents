  "process_ports": [
    {
      "port_id": "flow_input",
      "direction": "input",
      "label": "Pick Input",
      "role": "flow_input",
      "bound_physical_interface": "pick_area",
      "local_frame": {
        "position": [
          0.45,
          0,
          0.2
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "start_pick",
        "pause_pick",
        "resume_pick"
      ]
    },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Place Output",
      "role": "flow_output",
      "bound_physical_interface": "place_area",
      "local_frame": {
        "position": [
          -0.45,
          0,
          0.2
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          -1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "done"
      ]
    }
  ],
  "signal_ports": [
    {
      "port_id": "start_pick",
      "direction": "input",
      "value_type": "event",
      "description": "触发抓取动作",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "启动抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "pause_pick",
      "direction": "input",
      "value_type": "event",
      "description": "暂停启动新的抓取任务；通常由出料传送带 blocked 信号触发",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "暂停抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "resume_pick",
      "direction": "input",
      "value_type": "event",
      "description": "恢复启动新的抓取任务；通常由出料传送带 capacity_available 信号触发",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "恢复抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "description": "机械臂正在执行动作",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "执行机构忙碌状态。",
      "bound_to": {
        "type": "physical_interface",
        "id": "tool_center_point"
      }
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "description": "动作完成",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "event",
      "description": "动作失败或目标不可达",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "设备异常事件。",
      "bound_to": {
        "type": "physical_interface",
        "id": "tool_center_point"
      }
    }
  ],
  "interface_bindings": [
    {
      "process_port": "flow_input",
      "physical_interface": "pick_area",
      "binding_id": "bind_flow_input_pick_area",
      "binding_role": "entry",
      "signal_ports": [
        "start_pick",
        "pause_pick",
        "resume_pick"
      ],
      "transport_behaviors": [
        "pick_and_place"
      ]
    },
    {
      "process_port": "flow_output",
      "physical_interface": "place_area",
      "binding_id": "bind_flow_output_place_area",
      "binding_role": "exit",
      "signal_ports": [
        "done"
      ],
      "transport_behaviors": [
        "pick_and_place"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "pick_and_place",
      "behavior_type": "material_transfer",
      "input_physical_interface": "pick_area",
      "output_physical_interface": "place_area",
      "default_algorithm": "robot_pick_place",
      "input_signals": [
        "start_pick",
        "resume_pick"
      ],
      "control_signals": [
        "pause_pick"
      ],
      "output_signals": [
        "busy",
        "done",
        "error"
      ],
      "resources": [
        "robot_arm",
        "gripper"
      ],
      "preconditions": [
        "fsm_state == idle",
        "material_at(input_physical_interface)",
        "gripper.empty == true",
        "pause_pick.active != true"
      ],
      "effects": [
        "material_at(output_physical_interface)",
        "emit done"
      ]
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "busy",
      "waiting",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "robot_arm",
        "exclusive": true
      },
      {
        "resource_id": "gripper",
        "exclusive": true
      }
    ],
    "capacity": {
      "max_active_materials": 1
    },
    "error_policy": {
      "on_timeout": "emit_observation",
      "on_unreachable_target": "pause_and_request_replan"
    }
  },
  "runtime_execution_contract": {
    "path_resolution_order": [
      "Runtime event payload.waypoints",
      "Runtime event payload.pick_position + payload.place_position",
      "SceneDocument material/object asset bindings resolved by payload.material_id and payload.target_conveyor_id",
      "DeviceSpec.type_specific_contract.workspace fallback"
    ],
    "behavior_payloads": {
      "pick_and_place": {
        "subject_fields": ["material_id", "workpiece_id", "subject_id"],
        "target_fields": ["target_conveyor_id", "target_object_id", "to_instance_id"],
        "recommended_fields": ["pick_position", "place_position", "waypoints", "lift_height", "duration_s"]
      },
      "pause_pick": {
        "recommended_fields": ["reason", "source_signal", "conveyor_id"]
      },
      "resume_pick": {
        "recommended_fields": ["source_signal", "conveyor_id"]
      }
    },
    "ik_solver": {
      "type": "frontend_behavior_lib",
      "config_source": "type_specific_contract.urdf",
      "requires_glb_node_mapping": true
    }
  },
  "type_specific_contract": {
    "rootNodeName": "UR10_00Hn",
    "urdf": {
      "joints": [
        {
          "name": "joint_1",
          "nodeName": "Link1_00In",
          "type": "revolute",
          "axis": {
