  "created_for": "图 1 / 图 4 / 图 11 中机械臂设备本体建模",
  "references": [
    "schema.json",
    "../../../test/1.png",
    "../../../test/4.png",
    "../../../test/11.png"
  ],
  "notes": [
    "Physical interfaces are reserved for base/model connection anchors and are not used as material pick/place points.",
    "Pick and place points are process_ports with local_frame coordinates.",
    "TCP and IK node mapping remain in type_specific_contract, not physical_interfaces."
  ],
  "id": "robot_arm_1",
  "device_spec_id": "robot_arm_1",
  "device_type": "robot_arm",
  "display_name": "Fanuc 机械臂 1",
  "asset": {
    "model_format": "glb",
    "model_key": "assets/models/robot_arm/fanuc_robot_arm.glb",
    "root_node_name": "UR10_00Hn"
  },
  "params_schema": {
    "speed": {
      "type": "number",
      "default": 1,
      "min": 0.05,
      "max": 3,
      "unit": "m/s"
    },
    "payload_kg": {
      "type": "number",
      "default": 5,
      "min": 0,
      "max": 20,
      "unit": "kg"
    },
    "lift_height": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1.5,
      "unit": "m"
    }
  },
  "physical_interfaces": [
