        }
      ]
    },
    {
      "interface_id": "bbox_bottom_back_left",
      "kind": "layout_mount_anchor",
      "direction": "none",
      "node_name": "BboxBottomBackLeft",
      "local_frame": {
        "position": [
          -0.4,
          0.4,
          0
        ],
        "rotation_euler": [
          0,
