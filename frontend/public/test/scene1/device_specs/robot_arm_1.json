      "snap_tolerance": {
        "distance_m": 0.02,
        "angle_deg": 3
      },
      "compatibility_fields": [
        {
          "field_id": "anchor_role",
          "type": "layout_anchor",
          "name": "Anchor role",
          "value": "robot_base_mount",
          "match_rule": "equals"
        }
      ]
    }
  ],
  "process_ports": [
    {
      "port_id": "flow_input",
      "direction": "input",
      "label": "Pick Process Point",
      "role": "flow_input",
      "local_frame": {
        "position": [
          0.45,
          0,
          0.2
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "start_pick",
        "pause_pick",
        "resume_pick"
      ],
      "process_frame_role": "pick_point"
    },
    {
      "port_id": "flow_output",
      "direction": "output",
      "label": "Place Process Point",
      "role": "flow_output",
      "local_frame": {
        "position": [
          -0.45,
          0,
          0.2
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          -1,
          0,
          0
        ],
        "up": [
          0,
          0,
          1
        ]
      },
      "accepted_material_types": [
        "workpiece",
        "workpiece_carrier"
      ],
      "bound_signal_ports": [
        "done"
      ],
      "process_frame_role": "place_point"
    }
  ],
  "signal_ports": [
    {
      "port_id": "start_pick",
      "direction": "input",
      "value_type": "event",
      "description": "触发抓取动作",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "启动抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "pause_pick",
      "direction": "input",
      "value_type": "event",
      "description": "暂停启动新的抓取任务；通常由出料传送带 blocked 信号触发",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "暂停抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "resume_pick",
      "direction": "input",
      "value_type": "event",
      "description": "恢复启动新的抓取任务；通常由出料传送带 capacity_available 信号触发",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "恢复抓取命令。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_input"
      }
    },
    {
      "port_id": "busy",
      "direction": "output",
      "value_type": "boolean",
      "description": "机械臂正在执行动作",
      "edge_trigger": "on_change",
      "retention": "latest_value",
      "default_value": false,
      "semantic": "执行机构忙碌状态。"
    },
    {
      "port_id": "done",
      "direction": "output",
      "value_type": "event",
      "description": "动作完成",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "当前动作完成事件。",
      "bound_to": {
        "type": "process_port",
        "id": "flow_output"
      }
    },
    {
      "port_id": "error",
      "direction": "output",
      "value_type": "event",
      "description": "动作失败或目标不可达",
      "edge_trigger": "on_rising_edge",
      "retention": "event_log",
      "semantic": "设备异常事件。"
    }
  ],
  "interface_bindings": [
    {
      "process_port": "flow_input",
      "binding_id": "bind_flow_input_pick_point",
      "binding_role": "pick_point",
      "signal_ports": [
        "start_pick",
        "pause_pick",
        "resume_pick"
      ],
      "transport_behaviors": [
        "pick_and_place"
      ]
    },
    {
      "process_port": "flow_output",
      "binding_id": "bind_flow_output_place_point",
      "binding_role": "place_point",
      "signal_ports": [
        "done"
      ],
      "transport_behaviors": [
        "pick_and_place"
      ]
    }
  ],
  "transport_behaviors": [
    {
      "behavior_id": "pick_and_place",
      "behavior_type": "material_transfer",
      "default_algorithm": "robot_pick_place",
      "input_signals": [
        "start_pick",
        "resume_pick"
      ],
      "control_signals": [
        "pause_pick"
      ],
      "output_signals": [
        "busy",
        "done",
        "error"
      ],
      "resources": [
        "robot_arm",
        "gripper"
      ],
      "preconditions": [
        "fsm_state == idle",
        "material_at(input_process_port)",
        "gripper.empty == true",
        "pause_pick.active != true"
      ],
      "effects": [
        "material_at(output_process_port)",
        "emit done"
      ],
      "input_process_port": "flow_input",
      "output_process_port": "flow_output"
    }
  ],
  "runtime_contract": {
    "fsm_states": [
      "idle",
      "busy",
      "waiting",
      "error"
    ],
    "default_state": "idle",
    "resources": [
      {
        "resource_id": "robot_arm",
        "exclusive": true
      },
      {
        "resource_id": "gripper",
        "exclusive": true
      }
    ],
    "capacity": {
      "max_active_materials": 1
    },
    "error_policy": {
      "on_timeout": "emit_observation",
      "on_unreachable_target": "pause_and_request_replan"
    }
  },
  "runtime_execution_contract": {
    "path_resolution_order": [
      "Runtime event payload.waypoints",
      "Runtime event payload.pick_position + payload.place_position",
      "SceneDocument material/object asset bindings resolved by payload.material_id and payload.target_conveyor_id",
      "DeviceSpec.type_specific_contract.workspace fallback"
    ],
    "behavior_payloads": {
      "pick_and_place": {
        "subject_fields": [
          "material_id",
          "workpiece_id",
          "subject_id"
        ],
        "target_fields": [
          "target_conveyor_id",
          "target_object_id",
          "to_instance_id"
        ],
        "recommended_fields": [
          "pick_position",
          "place_position",
          "waypoints",
          "lift_height",
          "duration_s"
        ]
      },
      "pause_pick": {
        "recommended_fields": [
          "reason",
          "source_signal",
          "conveyor_id"
        ]
      },
      "resume_pick": {
        "recommended_fields": [
          "source_signal",
          "conveyor_id"
        ]
      }
    },
    "ik_solver": {
      "type": "frontend_behavior_lib",
      "config_source": "type_specific_contract.urdf",
      "requires_glb_node_mapping": true
    }
  },
  "type_specific_contract": {
    "rootNodeName": "UR10_00Hn",
    "urdf": {
      "joints": [
