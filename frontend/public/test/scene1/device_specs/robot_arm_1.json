{
  "schema_id": "robot_arm_1",
  "schema_type": "DeviceSpec",
  "version": "0.2.0",
  "name": "Fanuc 机械臂 1",
  "description": "Six-axis robot arm. Physical interfaces describe base/layout anchors; process ports describe pick/place material points.",
  "source": {
    "kind": "image_and_existing_driver_config",
    "path": "docs/business/SimulationSchema/1.DeviceSpec/robot_arm/robot_arm_1.json"
