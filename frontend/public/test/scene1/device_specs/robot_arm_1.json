          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        },
        {
          "name": "joint_3",
          "nodeName": "Link3_00Kn",
          "type": "revolute",
          "axis": {
            "x": 0,
            "y": 0,
            "z": 1
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        },
        {
          "name": "joint_4",
          "nodeName": "Link4_00Ln",
          "type": "revolute",
          "axis": {
            "x": 0,
