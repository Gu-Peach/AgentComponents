            "z": 0
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        },
        {
          "name": "joint_6",
          "nodeName": "Link6_00Nn",
          "type": "revolute",
          "axis": {
            "x": 0,
            "y": 1,
            "z": 0
          },
          "limit": {
            "lower": -1.57,
            "upper": 2.36
          }
        }
      ]
    },
    "trajectoryConfig": {
      "liftHeight": 0.3,
      "speed": 1
    },
    "workspace": {
      "shape": "cylinder",
      "radius_m": 1.2,
      "height_m": 1.5
    },
    "gripper": {
      "type": "vacuum_or_clamp",
      "supported_material_classes": [
        "workpiece",
        "workpiece_carrier"
      ],
      "max_payload_kg": 5
    },
    "tooling": {
      "tcp_node_name": "Link6_00Nn",
      "tcp_local_frame": {
        "position": [
          0,
          0,
          0.8
        ],
        "rotation_euler": [
          0,
          0,
          0
        ],
        "forward": [
          1,
          0,
